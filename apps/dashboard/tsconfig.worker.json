{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // WebWorker, not DOM: the Worker has fetch, crypto and Request/Response, but no document.
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": []
  },
  "include": ["src/worker", "src/shared"]
}
