{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emojisense-dashboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-24",
  "observability": { "enabled": true },
  "dev": { "port": 8790 },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker. The SPA files stay free static asset requests.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emojisense",
      // Placeholder for local development. Before a deploy, replace it with the id that
      // `wrangler d1 create emojisense` prints. The API Worker binds the same database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/platform/migrations"
    }
  ],
  // The waitlist is the only public write. Keyed by client IP, held in memory only.
  "ratelimits": [
    { "name": "WAITLIST_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Production values. `.dev.vars` overrides them locally (see .dev.vars.example).
  // Secrets: GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET (`wrangler secret put …`).
  "vars": {
    "ENVIRONMENT": "production",
    // Comma-separated website origins that may POST /api/waitlist from the browser.
    "WEBSITE_ORIGINS": ""
  }
}
