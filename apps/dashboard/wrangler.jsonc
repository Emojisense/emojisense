{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emojisense-dashboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-24",
  // Invocation logs would record full request URLs (search text, keys, invite tokens); only our
  // own structured logs, which never contain them, are kept.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "dev": { "port": 8790 },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker. The SPA files stay free static asset requests.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emojisense",
      // Placeholder for local development. Before a deploy, replace it with the id that
      // `wrangler d1 create emojisense` prints. The API Worker binds the same database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/platform/migrations"
    }
  ],
  // Custom emoji images. The API Worker binds the same bucket and serves them at
  // `${API_URL}/v1/custom/:appId/:emojiId`. Local R2 state is keyed by bucket_name, so both
  // Workers share it under --persist-to ../../.wrangler/state.
  "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji" }],
  // The waitlist is the only public write. Keyed by client IP, held in memory only.
  "ratelimits": [
    { "name": "WAITLIST_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Production values. `.dev.vars` overrides them locally (see .dev.vars.example).
  // Secrets: GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET (`wrangler secret put …`).
  "vars": {
    "ENVIRONMENT": "production",
    // Comma-separated website origins that may POST /api/waitlist from the browser.
    "WEBSITE_ORIGINS": "",
    // The API Worker's origin: custom emoji imageUrl values point at it.
    "API_URL": "https://api.emojisense.com"
  },
  "env": {
    // Internal dev environment at app.emojisense.dev (`pnpm deploy:dev`). Same D1 and R2 as the
    // dev API Worker. Secrets per env: `wrangler secret put GITHUB_CLIENT_SECRET --env dev`.
    "dev": {
      "routes": [{ "pattern": "app.emojisense.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense-dev",
          "database_id": "6e481b34-37e5-472b-9a74-0e7bfddae494",
          "migrations_dir": "../../packages/platform/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji-dev" }],
      "ratelimits": [
        { "name": "WAITLIST_LIMITER", "namespace_id": "2101", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "WEBSITE_ORIGINS": "https://emojisense.dev",
        "API_URL": "https://api.emojisense.dev"
      }
    },
    // Production at app.emojisense.com (`pnpm deploy:production`). Same D1 and R2 as the
    // production API Worker.
    "production": {
      "routes": [{ "pattern": "app.emojisense.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense-prod",
          "database_id": "6bb3345c-a77d-449a-bec3-f81a59a81439",
          "migrations_dir": "../../packages/platform/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji-prod" }],
      "ratelimits": [
        { "name": "WAITLIST_LIMITER", "namespace_id": "2201", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "WEBSITE_ORIGINS": "https://emojisense.com,https://www.emojisense.com",
        "API_URL": "https://api.emojisense.com"
      }
    }
  }
}
