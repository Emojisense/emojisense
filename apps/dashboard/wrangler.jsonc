{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emojisense-dashboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-24",
  // Invocation logs would record full request URLs (search text, keys, invite tokens); only our
  // own structured logs, which never contain them, are kept.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "dev": { "port": 8790 },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker. The SPA files stay free static asset requests.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emojisense",
      // Placeholder for local development. Before a deploy, replace it with the id that
      // `wrangler d1 create emojisense` prints. The API Worker binds the same database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/platform/migrations"
    }
  ],
  // Custom emoji images. The API Worker binds the same bucket and serves them at
  // `${API_URL}/v1/custom/:appId/:emojiId`. Local R2 state is keyed by bucket_name, so both
  // Workers share it under --persist-to ../../.wrangler/state.
  "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji" }],
  // The waitlist is the only public write. Keyed by client IP, held in memory only.
  // WEBHOOK_TEST_LIMITER: "Send test event" per webhook, so the dashboard cannot be used to flood
  // a receiver's URL.
  "ratelimits": [
    { "name": "WAITLIST_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
    { "name": "WEBHOOK_TEST_LIMITER", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Daily billing sweep (src/worker/index.ts `scheduled`): lapsed subscriptions to Free, and the
  // retry of Whop cancels for retired memberships. Repeated in each env block below.
  "triggers": { "crons": ["17 4 * * *"] },
  // Production values. `.dev.vars` overrides them locally (see .dev.vars.example).
  // Clerk sign-in needs CLERK_PUBLISHABLE_KEY and CLERK_JWT_KEY (both public) and, optionally,
  // CLERK_AUTHORIZED_PARTIES. The only optional secret is CLERK_SECRET_KEY (README, "Clerk").
  "vars": {
    "ENVIRONMENT": "production",
    // Comma-separated website origins that may POST /api/waitlist from the browser.
    "WEBSITE_ORIGINS": "",
    // The API Worker's origin: custom emoji imageUrl values point at it.
    "API_URL": "https://api.emojisense.com"
  },
  "env": {
    // Internal dev environment at app.emojisense.dev (`pnpm deploy:dev`). Same D1 and R2 as the
    // dev API Worker. Clerk values are public (publishable key, JWT public key); no secret is needed.
    "dev": {
      "routes": [{ "pattern": "app.emojisense.dev", "custom_domain": true }],
      "triggers": { "crons": ["17 4 * * *"] },
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense-dev",
          "database_id": "6e481b34-37e5-472b-9a74-0e7bfddae494",
          "migrations_dir": "../../packages/platform/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji-dev" }],
      "ratelimits": [
        { "name": "WAITLIST_LIMITER", "namespace_id": "2101", "simple": { "limit": 5, "period": 60 } },
        { "name": "WEBHOOK_TEST_LIMITER", "namespace_id": "2102", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "WEBSITE_ORIGINS": "https://emojisense.dev",
        "API_URL": "https://api.emojisense.dev",
        // Clerk development instance (public values).
        "CLERK_PUBLISHABLE_KEY": "pk_test_ZmVhc2libGUtYmxvd2Zpc2gtOTY4MC5jbGVyay5hY2NvdW50cy5kZXYk",
        "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAsupJQ5+kY53VsrOu2/E9\ndDlE7Gou5HS+BwHZfOlCSy0RG9WKMIH6+Ajs9Nz4ZRIwgj29gQLzC5KcroSkRE9X\n3c+Wo3doUeKC5W9XkOzAe5Wcl+QVLPxD8ZbUEw1RvOx0T/GUUfgPI6AhlwneWXZ6\n1sX/N1tcGLQEQQK62cbZ2qtN7Mc4YAqihZdPvYfz0tYuKFBtiDwXycRSEutK3X2v\nIx2l6Lo69QTKlQpCNAtqmn6xZQ18iBXifd33osYV6UBRz5d5Sk0EbPZUO5REKlYK\n7vG6eh/sS8j/gtU2Xxmf/uMxImX6seK5xFsWDTAWQ1nEOlsflP8eD6eWlxweC7PI\ngwIDAQAB\n-----END PUBLIC KEY-----",
        "CLERK_AUTHORIZED_PARTIES": "https://app.emojisense.dev"
      }
    },
    // Production at app.emojisense.com (`pnpm deploy:production`). Same D1 and R2 as the
    // production API Worker.
    "production": {
      "routes": [{ "pattern": "app.emojisense.com", "custom_domain": true }],
      "triggers": { "crons": ["17 4 * * *"] },
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense-prod",
          "database_id": "6bb3345c-a77d-449a-bec3-f81a59a81439",
          "migrations_dir": "../../packages/platform/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji-prod" }],
      "ratelimits": [
        { "name": "WAITLIST_LIMITER", "namespace_id": "2201", "simple": { "limit": 5, "period": 60 } },
        { "name": "WEBHOOK_TEST_LIMITER", "namespace_id": "2202", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "WEBSITE_ORIGINS": "https://emojisense.com,https://www.emojisense.com",
        "API_URL": "https://api.emojisense.com",
        // Clerk production instance (public values).
        "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZW1vamlzZW5zZS5jb20k",
        "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAnRUDxztDHPEnTJkqUJi+\nYDw9R2rBtq3q9LPDf9iP7G8YaM/YPWs26KVZR2gsqwXLTWnVzMnMU91oFguO+Q1J\na944T6T1Zs4U2W2HHTL3JYY1ytQISLIaltZhZSsAWp83bdqGn3XIGdg5pxXXc2sT\ngWIDyGtEjDDJG8CbFbLTlcQq7UfYhqYjw3pvldtDO8SObiL60sCfwIYKgXhTVdGT\nT2k6r/5Cdd8gl8afUw0uSM/UaR6h9mAAg8Jh5UisyLxA5WTFwB6TI0RzLyD8i4bh\n9MHHP+xB1xXlYE2sLrHxf5cT4avZTcUIHdTOLGNjWMOldTCSz03j8jtDbX2HMUZ5\niwIDAQAB\n-----END PUBLIC KEY-----",
        "CLERK_AUTHORIZED_PARTIES": "https://app.emojisense.com"
      }
    }
  }
}
