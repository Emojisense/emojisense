# Copy to .dev.vars (gitignored). `wrangler dev` reads it and overrides the vars in wrangler.jsonc.

# Enables the dev sign-in at /api/auth/dev (it also requires a localhost URL).
ENVIRONMENT=development

# Website origins that may POST /api/waitlist (comma-separated).
WEBSITE_ORIGINS=http://localhost:5173,http://localhost:4321

# The local API Worker, which serves custom emoji images (pnpm --filter @emojisense/worker dev:offline).
API_URL=http://localhost:8788

# Clerk (optional locally: without it only the dev sign-in works). Use the development instance.
# Public values; also put the publishable key in apps/dashboard/.env.local as
# VITE_CLERK_PUBLISHABLE_KEY so the SPA is built with Clerk. See the README, "Clerk".
CLERK_PUBLISHABLE_KEY=
# Clerk Dashboard → API keys → Show JWT public key → PEM (one line is fine).
CLERK_JWT_KEY=
# Comma-separated origins whose session tokens count. Empty = the dashboard's own origin.
CLERK_AUTHORIZED_PARTIES=
# Optional secret: only lets DELETE /api/me delete the Clerk user on the server.
# CLERK_SECRET_KEY=

# Who sees the internal Culture page (comma-separated verified emails). The dev sign-in's email
# is <login>@dev.localhost. The page also needs the local API Worker (CULTURE_ADMIN binding).
ADMIN_EMAILS=ada@dev.localhost
