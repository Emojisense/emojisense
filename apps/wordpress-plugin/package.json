{
  "name": "@emojisense/wordpress-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "WordPress plugin: emoji by meaning in the block editor, the classic editor, comments and post reactions.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build && node scripts/copy-data.mjs",
    "dev": "wp-scripts start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:forums": "E2E_FORUMS=1 node scripts/e2e.mjs",
    "wporg-assets": "node scripts/wporg-assets.mjs"
  },
  "dependencies": {
    "@emojisense/web-component": "workspace:*",
    "emojisense": "workspace:*"
  },
  "devDependencies": {
    "@emojisense/data": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@types/node": "24.13.6",
    "@wordpress/scripts": "36.0.0",
    "happy-dom": "20.14.5",
    "playwright-core": "1.63.0"
  }
}
