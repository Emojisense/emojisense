{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emojisense-web",
  "compatibility_date": "2026-09-24",
  // Shared playground searches only (src/worker/): `/s/?q=…` pages and their `/og/q/…` query cards.
  // Every other request is a static asset: free, and it never runs Worker code.
  "main": "src/worker/index.ts",
  // Logs without request URLs: the paths carry search text.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/s", "/s/*", "/og/q/*"]
  },
  // The share-card fonts (src/og/fonts/) are bundled with the Worker as bytes.
  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }],
  // Local `wrangler dev`: the API's own local dev session, when one runs.
  "services": [{ "binding": "API", "service": "emojisense-api" }],
  // Query-card renders (cache misses only): per visitor IP, and per Cloudflare location for everyone.
  "ratelimits": [
    { "name": "OG_IP_LIMITER", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
    { "name": "OG_LOCATION_LIMITER", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } }
  ],
  "env": {
    // Internal dev environment at emojisense.dev (`pnpm deploy:dev`). The build sets
    // PUBLIC_INDEXABLE=false, so robots.txt disallows everything and pages send noindex.
    "dev": {
      "routes": [{ "pattern": "emojisense.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "services": [{ "binding": "API", "service": "emojisense-api-dev" }],
      "ratelimits": [
        { "name": "OG_IP_LIMITER", "namespace_id": "3101", "simple": { "limit": 10, "period": 60 } },
        { "name": "OG_LOCATION_LIMITER", "namespace_id": "3102", "simple": { "limit": 60, "period": 60 } }
      ]
    },
    // Production at emojisense.com. www serves the same files; every page's canonical link
    // points at the apex.
    "production": {
      "routes": [
        { "pattern": "emojisense.com", "custom_domain": true },
        { "pattern": "www.emojisense.com", "custom_domain": true }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "services": [{ "binding": "API", "service": "emojisense-api-production" }],
      "ratelimits": [
        { "name": "OG_IP_LIMITER", "namespace_id": "3201", "simple": { "limit": 10, "period": 60 } },
        { "name": "OG_LOCATION_LIMITER", "namespace_id": "3202", "simple": { "limit": 60, "period": 60 } }
      ]
    }
  }
}
