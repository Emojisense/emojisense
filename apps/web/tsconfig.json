{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "src", "test", "astro.config.ts", "vitest.config.ts"],
  // The Worker has its own runtime types (tsconfig.worker.json).
  "exclude": ["dist", "src/worker"]
}
