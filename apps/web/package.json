{
  "name": "@emojisense/web",
  "version": "0.0.0",
  "private": true,
  "description": "Public website: landing, pricing, docs and the Pro waitlist.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "typecheck": "astro check && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "deploy": "astro build && wrangler deploy",
    "brand:assets": "node scripts/brand-assets.mjs",
    "record:meaning": "tsx scripts/record-meaning.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@emojisense/platform": "workspace:*",
    "@emojisense/react": "workspace:*",
    "@emojisense/tiptap": "workspace:*",
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "astro": "7.3.5",
    "bidi-js": "1.1.0",
    "emojisense": "workspace:*",
    "harfbuzzjs": "0.3.6",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260924.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "wrangler": "4.139.0"
  }
}
