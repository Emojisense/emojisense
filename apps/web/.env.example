# Copy to .env and adjust. All values are public: they end up in the built pages.

# Canonical origin of this site (canonical links, sitemap, structured data).
PUBLIC_SITE_URL=https://emojisense.com
# Search API (packages/worker). The live search loads packs from it and asks it about meaning.
PUBLIC_API_URL=http://localhost:8788
PUBLIC_PACK_VERSION=0.1.0
# Precomputed results (layer 2). Default: $PUBLIC_API_URL/p/$PUBLIC_PACK_VERSION (the Worker route).
# PUBLIC_SHARDS_URL=https://cdn.emojisense.com/p/0.1.0
# Search reports (POST /v1/events) of the visitors' own typing, from a share of visits. Off when unset.
# PUBLIC_STATS_URL=https://stats.emojisense.com
# PUBLIC_STATS_SAMPLE=0.1
# The site's own publishable key. In production, bind it to PUBLIC_SITE_URL in the dashboard.
PUBLIC_PUBLISHABLE_KEY=pk_demo
# Dashboard (apps/dashboard). The waitlist form posts to $PUBLIC_DASHBOARD_URL/api/waitlist.
PUBLIC_DASHBOARD_URL=http://localhost:8790
PUBLIC_REPO_URL=https://github.com/emojisense/emojisense
# Analytics, off when unset. Cloudflare Web Analytics sets no cookies. Google Analytics loads with
# Consent Mode (storage denied) and shows the cookie banner.
# PUBLIC_CF_WEB_ANALYTICS_TOKEN=
# PUBLIC_GA_MEASUREMENT_ID=
