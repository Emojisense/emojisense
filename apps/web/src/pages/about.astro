---
import PageHero from "../components/PageHero.astro";
import { DASHBOARD_URL, REPO_URL } from "../config";
import { i18nFor } from "../i18n/page";
import Base from "../layouts/Base.astro";
import { packFacts } from "../lib/pack-facts";
import { comparisons } from "../lib/showcase";

const { t, parts, href, locale, tag } = i18nFor(Astro);
/** Real answers from the engine on the shipped packs (computed at build time). */
const examples = comparisons.slice(0, 3);
const number = new Intl.NumberFormat(tag);
/** The examples are English searches; a translated page marks them as such. */
const exampleLang = locale === "en" ? undefined : "en";

const principles = [
  {
    emoji: "🛟",
    title: t("about.principles.neverBreaks.title"),
    text: t("about.principles.neverBreaks.text"),
  },
  { emoji: "🔏", title: t("about.principles.private.title"), text: t("about.principles.private.text") },
  { emoji: "🧩", title: t("about.principles.open.title"), text: t("about.principles.open.text") },
  { emoji: "🌍", title: t("about.principles.languages.title"), text: t("about.principles.languages.text") },
];

const pack = packFacts
  ? t("about.now.pack", {
      count: number.format(packFacts.emojiCount),
      emojiVersion: packFacts.emojiVersion,
      languages: number.format(packFacts.languages),
    })
  : t("about.now.packs");
---

<Base title={t("meta.about.title")} description={t("meta.about.description")} path="/about/">
  <PageHero eyebrow={t("about.hero.eyebrow")} emoji="🦖" title={t("about.hero.title")}>
    <p>{t("about.hero.lead")}</p>
  </PageHero>

  <div class="container about">
    <section class="about-section" aria-labelledby="why">
      <h2 id="why">{t("about.why.title")}</h2>
      <p>{t("about.why.body")}</p>
      {
        examples.length > 0 && (
          <div class="about-examples" role="table" aria-label={t("about.why.tableLabel")}>
            <div class="about-row about-row-head" role="row">
              <span role="columnheader">{t("about.why.colQuery")}</span>
              <span role="columnheader">{t("about.why.colName")}</span>
              <span role="columnheader">{t("about.why.colUs")}</span>
            </div>
            {examples.map((example) => (
              <div class="about-row" role="row">
                <span role="cell" class="about-query" lang={exampleLang}>
                  {example.query}
                </span>
                <span role="cell" class="about-none">
                  {example.name.length > 0 ? <span class="emoji">{example.name.join(" ")}</span> : t("about.why.nothing")}
                </span>
                <span role="cell" class="about-ours">
                  <span class="emoji">{example.emojisense.join(" ")}</span>
                </span>
              </div>
            ))}
          </div>
        )
      }
    </section>

    <section class="about-section" aria-labelledby="how">
      <h2 id="how">{t("about.how.title")}</h2>
      <p>{t("about.how.body")}</p>
    </section>

    <section class="about-section" aria-labelledby="believe">
      <h2 id="believe">{t("about.principles.title")}</h2>
      <ul class="about-principles">
        {
          principles.map((principle) => (
            <li>
              <span class="about-principle-icon" aria-hidden="true">
                <span class="emoji">{principle.emoji}</span>
              </span>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-section" aria-labelledby="money">
      <h2 id="money">{t("about.money.title")}</h2>
      <p>
        {
          parts("about.money.body").map((part) =>
            part.tag === "pricing" ? (
              <a href={href("/pricing/")}>{part.text}</a>
            ) : part.tag === "free" ? (
              <a href={`${DASHBOARD_URL}/`}>{part.text}</a>
            ) : (
              part.text
            ),
          )
        }
      </p>
    </section>

    <section class="about-section" aria-labelledby="now">
      <h2 id="now">{t("about.now.title")}</h2>
      <p>
        {
          parts("about.now.body", { pack }).map((part) =>
            part.tag === "changelog" ? (
              <a href="/changelog/" hreflang={exampleLang}>
                {part.text}
              </a>
            ) : (
              part.text
            ),
          )
        }
      </p>
      <p>
        {
          parts("about.now.independent").map((part) =>
            part.tag === "issues" ? <a href={`${REPO_URL}/issues`}>{part.text}</a> : part.text,
          )
        }
      </p>
    </section>
  </div>
</Base>

<style>
  .about {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 46rem;
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .about-section {
    display: grid;
    gap: 0.875rem;
  }

  h2 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
    letter-spacing: -0.03em;
  }

  .about-section > p {
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .about-section a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .about-section a:hover {
    text-decoration-color: currentColor;
  }

  .about-examples {
    margin-top: 0.5rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .about-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 0.875rem 1.125rem;
  }

  .about-row + .about-row {
    border-top: 0.0625rem solid var(--line);
  }

  .about-row-head {
    background: var(--bg-soft);
    color: var(--ink-3);
    font: 500 0.75rem / 1 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .about-query {
    font-weight: 500;
  }

  .about-none {
    color: var(--ink-3);
    font: 400 0.875rem / 1 var(--font-mono);
  }

  .about-ours {
    font-size: 1.375rem;
    letter-spacing: 0.15em;
  }

  .about-principles {
    display: grid;
    gap: 0.75rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-principles li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 1.125rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .about-principle-icon {
    display: grid;
    grid-row: span 2;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: var(--bg-soft);
    font-size: 1.375rem;
  }

  .about-principles h3 {
    align-self: end;
    font-size: 1.0625rem;
  }

  .about-principles p {
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (min-width: 40rem) {
    .about-principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
