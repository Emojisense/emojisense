---
import PageHero from "../components/PageHero.astro";
import { DASHBOARD_URL, REPO_URL } from "../config";
import Base from "../layouts/Base.astro";
import { packFacts } from "../lib/pack-facts";
import { comparisons } from "../lib/showcase";

/** Real answers from the engine on the shipped packs (computed at build time). */
const examples = comparisons.slice(0, 3);
const number = new Intl.NumberFormat("en");

const principles = [
  {
    emoji: "🛟",
    title: "It never breaks",
    text: "Over a plan limit, search keeps working on the device. Your users never see an error because of a bill.",
  },
  {
    emoji: "🔏",
    title: "Private by design",
    text: "Most searches never leave the device. We never store who searched, message text or photos.",
  },
  {
    emoji: "🧩",
    title: "Open at the core",
    text: "The engine, data packs, SDKs and API server are MIT. Run them yourself if you like.",
  },
  {
    emoji: "🌍",
    title: "Every language",
    text: "People search in their own words and their own language, so the dictionary does too.",
  },
];
---

<Base
  title="About"
  description="Why Emojisense exists, how it works, how it makes money, and where it is today."
  path="/about/"
>
  <PageHero eyebrow="About" emoji="🦖" title="Emoji, the way people mean them.">
    <p>
      Emojisense is the complete emoji platform for every app: search, reactions, photo to emoji, custom emoji and
      more, in every language.
    </p>
  </PageHero>

  <div class="container about">
    <section class="about-section" aria-labelledby="why">
      <h2 id="why">Why it exists</h2>
      <p>
        Most emoji pickers match the official names of emoji. People do not type names. They type a film, a feeling, an
        idiom or a typo, and a name search finds nothing. We built the search that understands them, and then everything
        else a product needs around emoji.
      </p>
      {
        examples.length > 0 && (
          <div class="about-examples" role="table" aria-label="Name search compared with Emojisense">
            <div class="about-row about-row-head" role="row">
              <span role="columnheader">People type</span>
              <span role="columnheader">Name search</span>
              <span role="columnheader">Emojisense</span>
            </div>
            {examples.map((example) => (
              <div class="about-row" role="row">
                <span role="cell" class="about-query">
                  {example.query}
                </span>
                <span role="cell" class="about-none">
                  {example.name.length > 0 ? <span class="emoji">{example.name.join(" ")}</span> : "nothing"}
                </span>
                <span role="cell" class="about-ours">
                  <span class="emoji">{example.emojisense.join(" ")}</span>
                </span>
              </div>
            ))}
          </div>
        )
      }
    </section>

    <section class="about-section" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <p>
        A small dictionary runs on the device and answers most searches in under a millisecond. Common searches have
        ready-made answers in static files. Only the unusual ones go to our API on Cloudflare's network, which finds emoji
        by meaning and answers close to the person typing.
      </p>
    </section>

    <section class="about-section" aria-labelledby="believe">
      <h2 id="believe">What we hold to</h2>
      <ul class="about-principles">
        {
          principles.map((principle) => (
            <li>
              <span class="about-principle-icon" aria-hidden="true">
                <span class="emoji">{principle.emoji}</span>
              </span>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-section" aria-labelledby="money">
      <h2 id="money">How we make money</h2>
      <p>
        Search and reaction suggestions are free on every plan. Paid plans add volume, photo to emoji, custom emoji,
        analytics, teams and tenants. No ads, and we do not sell data. Paid plans are not on sale yet: you can{" "}
        <a href="/waitlist/">join the waitlist</a>, or <a href={`${DASHBOARD_URL}/`}>start free</a> today.
      </p>
    </section>

    <section class="about-section" aria-labelledby="now">
      <h2 id="now">Where we are</h2>
      <p>
        Early. The engine, {
          packFacts
            ? `the data pack (${number.format(packFacts.emojiCount)} emoji, Emoji ${packFacts.emojiVersion}, ${packFacts.languages} languages)`
            : "the data packs"
        }, the API and the dashboard work today. Payments come next. The <a href="/changelog/">changelog</a> keeps
        track.
      </p>
      <p>
        Emojisense is an independent project. Questions, ideas and bug reports are welcome in the{" "}
        <a href={`${REPO_URL}/issues`}>GitHub issues</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .about {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 46rem;
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .about-section {
    display: grid;
    gap: 0.875rem;
  }

  h2 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
    letter-spacing: -0.03em;
  }

  .about-section > p {
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .about-section a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .about-section a:hover {
    text-decoration-color: currentColor;
  }

  .about-examples {
    margin-top: 0.5rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .about-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 0.875rem 1.125rem;
  }

  .about-row + .about-row {
    border-top: 0.0625rem solid var(--line);
  }

  .about-row-head {
    background: var(--bg-soft);
    color: var(--ink-3);
    font: 500 0.75rem / 1 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .about-query {
    font-weight: 500;
  }

  .about-none {
    color: var(--ink-3);
    font: 400 0.875rem / 1 var(--font-mono);
  }

  .about-ours {
    font-size: 1.375rem;
    letter-spacing: 0.15em;
  }

  .about-principles {
    display: grid;
    gap: 0.75rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-principles li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 1.125rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .about-principle-icon {
    display: grid;
    grid-row: span 2;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: var(--bg-soft);
    font-size: 1.375rem;
  }

  .about-principles h3 {
    align-self: end;
    font-size: 1.0625rem;
  }

  .about-principles p {
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (min-width: 40rem) {
    .about-principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
