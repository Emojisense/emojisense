---
import PageHero from "../components/PageHero.astro";
import Pricing from "../components/Pricing.astro";
import { DASHBOARD_URL, SITE_URL } from "../config";
import Base from "../layouts/Base.astro";
import { planViews } from "../lib/pricing";

const offers = planViews(DASHBOARD_URL).map((plan) => ({
  "@type": "Offer",
  name: plan.name,
  price: plan.monthlyUsd,
  priceCurrency: "USD",
}));

const faqs = [
  {
    q: "What counts as a Worker call?",
    a: "A search or reaction suggestion that reaches our API. Searches answered on the device or from precomputed files are free and unlimited.",
  },
  {
    q: "What happens over the limit?",
    a: "Nothing breaks for your users. Answers that are cached at the edge or prepared in advance keep coming and are not counted. Brand-new searches use the on-device dictionary until the next month.",
  },
  {
    q: "Can I self-host instead?",
    a: "Yes. The engine, data and API server are MIT. You pay your own Cloudflare costs and get quarterly dictionary updates.",
  },
  {
    q: "When do paid plans open?",
    a: "Soon. Join the waitlist and we write once, when your plan opens. The free plan works today.",
  },
];
---

<Base
  title="Pricing"
  description="Emojisense pricing: free for most apps. Pay for volume, photo classifications and custom emoji."
  path="/pricing/"
  jsonLd={{ "@context": "https://schema.org", "@type": "Product", name: "Emojisense", url: `${SITE_URL}/pricing/`, offers }}
>
  <PageHero eyebrow="Pricing" emoji="💸" title="Free to start. Fair when you grow.">
    <p>Search and reaction suggestions are free on every plan. Pay only for volume, photos and custom emoji.</p>
  </PageHero>
  <section class="section" style="padding-top: 1rem">
    <div class="container">
      <Pricing />
    </div>
  </section>
  <section class="section section-soft">
    <div class="container narrow">
      <h2>Pricing questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 50rem;
  }

  h2 {
    margin-bottom: 1.5rem;
    font-size: 2rem;
    text-align: center;
  }

  .faq {
    display: grid;
    gap: 0.75rem;
  }

  details {
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }

  summary {
    padding: 1.125rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
  }

  details p {
    padding: 0 1.25rem 1.25rem;
    color: var(--ink-2);
  }
</style>
