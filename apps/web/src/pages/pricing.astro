---
import BeyondPlans from "../components/pricing/BeyondPlans.astro";
import CallsExplainer from "../components/pricing/CallsExplainer.astro";
import ComparisonTable from "../components/pricing/ComparisonTable.astro";
import { pricingFaqs } from "../components/pricing/faq";
import PricingFaq from "../components/pricing/PricingFaq.astro";
import PricingHero from "../components/pricing/PricingHero.astro";
import { DASHBOARD_URL, SITE_URL } from "../config";
import { LOCALE_INFO, localizePath } from "../i18n/locales";
import { i18nFor } from "../i18n/page";
import { pricingLocaleFor } from "../i18n/pricing";
import Base from "../layouts/Base.astro";
import { planViews } from "../lib/pricing";

const { t, locale, tag, messages } = i18nFor(Astro);
const url = `${SITE_URL}${localizePath("/pricing/", locale)}`;
const faqs = pricingFaqs(undefined, {
  tag,
  items: messages.pricing.faq.items,
  unlimited: messages.plans.unlimited,
  docsInEnglish: locale !== "en",
});
const offers = planViews(DASHBOARD_URL, undefined, pricingLocaleFor(locale)).map((plan) => ({
  "@type": "Offer",
  name: plan.name,
  price: plan.monthlyUsd,
  priceCurrency: "USD",
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Product", name: "Emojisense", url, offers },
    {
      "@type": "FAQPage",
      url,
      inLanguage: LOCALE_INFO[locale].tag,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<Base title={t("meta.pricing.title")} description={t("meta.pricing.description")} path="/pricing/" jsonLd={jsonLd}>
  <PricingHero />
  <ComparisonTable />
  <CallsExplainer />
  <BeyondPlans />
  <PricingFaq faqs={faqs} />

  <section class="final" aria-labelledby="final-title">
    <div class="container final-inner">
      <p class="final-emoji emoji" aria-hidden="true">🦖</p>
      <h2 id="final-title">{t("pricing.final.title")}</h2>
      <p>{t("pricing.final.text")}</p>
      <div class="final-ctas">
        <a class="btn btn-primary btn-lg" href={`${DASHBOARD_URL}/`}>{t("pricing.final.ctaKey")}</a>
        <a class="btn btn-secondary btn-lg" href="/docs/" hreflang={locale === "en" ? undefined : "en"}>
          {t("pricing.final.ctaDocs")}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .final {
    padding: clamp(4.5rem, 10vw, 7.5rem) 0;
    border-top: 0.0625rem solid var(--line);
    text-align: center;
  }

  .final-inner {
    display: grid;
    justify-items: center;
  }

  .final-emoji {
    font-size: 3.5rem;
  }

  .final h2 {
    margin-top: 1rem;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.25rem);
  }

  .final p:not(.final-emoji) {
    max-width: 30rem;
    margin-top: 0.875rem;
    color: var(--ink-2);
    font-size: 1.125rem;
  }

  .final-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
