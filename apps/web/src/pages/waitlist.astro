---
import { PLANS, WAITLIST_STATUS_ANCHORS } from "@emojisense/platform";
import PageHero from "../components/PageHero.astro";
import { PLAN_COPY } from "../components/pricing/plan-copy";
import { DASHBOARD_URL, WAITLIST_ENDPOINT } from "../config";
import { WaitlistForm } from "../islands/WaitlistForm";
import Base from "../layouts/Base.astro";
import { formatUsd } from "../lib/format";
import { type PlanFeature, planViews } from "../lib/pricing";
import { RETURN_MESSAGES, WAITLIST_PLANS, type WaitlistPlan } from "../lib/waitlist";

const plans = Object.fromEntries(
  WAITLIST_PLANS.map((id) => [
    id,
    { name: PLANS[id].name, price: `${formatUsd(PLANS[id].priceUsdMonthly)} a month` },
  ]),
) as Record<WaitlistPlan, { name: string; price: string }>;

const HIGHLIGHTS_SHOWN = 3;
const paid = planViews(DASHBOARD_URL).filter((view) =>
  (WAITLIST_PLANS as readonly string[]).includes(view.id),
);

/**
 * AI calls first, then what the plan adds that the one before lacks (tenants, team members),
 * then custom emoji, then the other raised limits.
 */
function keyHighlights(highlights: PlanFeature[]): PlanFeature[] {
  const rank = (feature: PlanFeature) => {
    if (feature.key === "semantic_calls") return 0;
    if (feature.value === true) return 1;
    return feature.key === "custom_emoji" ? 2 : 3;
  };
  return [...highlights].sort((a, b) => rank(a) - rank(b)).slice(0, HIGHLIGHTS_SHOWN);
}

function describe(feature: PlanFeature): string {
  return typeof feature.value === "string"
    ? `${feature.value} ${feature.unit ?? feature.label}`
    : feature.label;
}
---

<Base
  title="Waitlist"
  description="Join the Emojisense waitlist for Solo, Pro or Scale. We email you once, when your plan opens."
  path="/waitlist/"
>
  <PageHero eyebrow="Solo · Pro · Scale" emoji="⏳" title="Be first when paid plans open.">
    <p>Paid plans are not on sale yet. Leave your email and we write once, when your plan opens. The free plan works today.</p>
  </PageHero>

  <div class="container wl-layout">
    <section class="card wl-panel" aria-label="Waitlist form">
      {/* Without JavaScript the dashboard redirects back to /waitlist/?status=…#<anchor>; the anchor
          makes the matching message the :target, so CSS alone shows it. */}
      <noscript>
        <div id={WAITLIST_STATUS_ANCHORS.ok} class="wl-result" role="status" tabindex="-1">
          <p class="wl-result-title">
            <span class="emoji" aria-hidden="true">🎟️</span>
            {RETURN_MESSAGES.ok.title}
          </p>
          <p>{RETURN_MESSAGES.ok.text}</p>
        </div>
        <div id={WAITLIST_STATUS_ANCHORS.error} class="wl-result wl-result-error" role="alert" tabindex="-1">
          <p class="wl-result-title">
            <span class="emoji" aria-hidden="true">😬</span>
            {RETURN_MESSAGES.error.title}
          </p>
          <p>{RETURN_MESSAGES.error.text}</p>
        </div>
      </noscript>
      <WaitlistForm client:load endpoint={WAITLIST_ENDPOINT} plans={plans} initialPlan="pro" />
    </section>

    <aside class="wl-plans" aria-labelledby="wl-plans-title">
      <h2 id="wl-plans-title" class="wl-plans-title">Paid plans at a glance</h2>
      <ul>
        {
          paid.map((view) => (
            <li class="wl-plan">
              <span class="wl-plan-icon" aria-hidden="true">
                <span class="emoji">{PLAN_COPY[view.id].emoji}</span>
              </span>
              <div class="wl-plan-body">
                <p class="wl-plan-head">
                  <span class="wl-plan-name">{view.name}</span>
                  <span class="wl-plan-price">
                    {view.monthly}
                    <span>/ month</span>
                  </span>
                </p>
                <p class="wl-plan-inherits">{view.inherits ? `Everything in ${view.inherits}, plus` : "Includes"}</p>
                <ul class="wl-plan-features">
                  {keyHighlights(view.highlights).map((feature) => (
                    <li>{describe(feature)}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="wl-plans-foot">
        <a href="/pricing/">Compare all plans</a>
        <span aria-hidden="true">·</span>
        <a href={`${DASHBOARD_URL}/`}>Start free, no waitlist</a>
      </p>
    </aside>
  </div>
</Base>

<style>
  .wl-layout {
    display: grid;
    gap: 2.5rem;
    max-width: 62rem;
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .wl-panel {
    align-self: start;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .wl-result {
    display: none;
    margin-bottom: 1.25rem;
    padding: 0.875rem 1rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .wl-result:target {
    display: block;
  }

  .wl-result:focus {
    outline: none;
  }

  .wl-result-error {
    border-color: color-mix(in srgb, var(--bad) 45%, var(--line));
  }

  .wl-result-title {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
    color: var(--ink);
    font-weight: 600;
  }

  .wl-plans-title {
    margin-bottom: 1rem;
    color: var(--ink-3);
    font: 500 0.8125rem / 1 var(--font-mono);
    letter-spacing: 0.02em;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wl-plan {
    display: flex;
    gap: 1rem;
    padding-block: 1.125rem;
    border-top: 0.0625rem solid var(--line);
  }

  .wl-plan:last-child {
    border-bottom: 0.0625rem solid var(--line);
  }

  .wl-plan-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
    font-size: 1.375rem;
  }

  .wl-plan-body {
    flex: 1;
    min-width: 0;
  }

  .wl-plan-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .wl-plan-name {
    font: 650 1.125rem / 1.2 var(--font-display);
    letter-spacing: -0.02em;
  }

  .wl-plan-price {
    font: 700 1.125rem / 1 var(--font-display);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .wl-plan-price span {
    margin-left: 0.25rem;
    color: var(--ink-3);
    font: 400 0.8125rem / 1 var(--font-body);
    letter-spacing: 0;
  }

  .wl-plan-inherits {
    margin: 0.375rem 0 0.25rem;
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .wl-plan-features {
    display: grid;
    gap: 0.125rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .wl-plan-features li::before {
    content: "+";
    display: inline-block;
    width: 1rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
  }

  .wl-plans-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.125rem;
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  .wl-plans-foot a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .wl-plans-foot a:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 52rem) {
    .wl-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: 4rem;
    }

    .wl-plans {
      padding-top: 0.5rem;
    }
  }
</style>
