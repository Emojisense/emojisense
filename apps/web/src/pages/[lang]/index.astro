---
/** The landing page in every language but English. The page itself reads Astro.currentLocale. */
import { PREFIXED_LOCALES } from "../../i18n/locales";
import Home from "../index.astro";

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((lang) => ({ params: { lang } }));
}
---

<Home />
