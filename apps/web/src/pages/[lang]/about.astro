---
/** The about page in every language but English. The page itself reads Astro.currentLocale. */
import { PREFIXED_LOCALES } from "../../i18n/locales";
import About from "../about.astro";

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((lang) => ({ params: { lang } }));
}
---

<About />
