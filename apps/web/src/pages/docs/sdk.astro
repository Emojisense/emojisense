---
import {
  applySkinTone,
  baseId,
  DEFAULT_SEMANTIC_CALIBRATION,
  emojiImageUrl,
  groupLabel,
  hexcodeOf,
  normalize,
  tokenize,
} from "emojisense";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import DocsLayout from "../../components/docs/DocsLayout.astro";
import { API_HOST, PACK_URL, resultLiteral, SHARDS_URL } from "../../components/docs/facts";
import InstallTabs from "../../components/docs/InstallTabs.astro";

const engine = `function createEngine(
  input: Pack | Pack[],
  options?: { minCoverage?: number; culture?: Culture },
): AliasEngine;

interface AliasEngine {
  search(query: string, options?: AliasSearchOptions): AliasSearchOutput;
  // culture: false gives the canonical ranking, typed as alias results only
  search(query: string, options: AliasSearchOptions & { culture: false }): CanonicalSearchOutput;
  get(id: string): EmojiEntry | undefined;
  withCulture(culture: Culture | undefined): AliasEngine; // shares the index
  readonly culture: Culture | undefined;
  readonly entries: readonly EmojiEntry[];
  readonly locales: readonly string[];
  readonly packVersion: string;
}

interface AliasSearchOptions {
  limit?: number; // default 24
  locale?: string;
  prefix?: boolean; // default true
  culture?: boolean; // false = canonical ranking only
  region?: string; // default: the device's region; "" = none; or ISO 3166-1 alpha-2, "JP"
  now?: Date | number; // the day culture windows are checked against; default: the device's local day
  day?: string; // "YYYY-MM-DD", wins over now
}`;

const engineExample = `const packs = await loadPacks({ baseUrl: "${PACK_URL}" });
const engine = createEngine(packs);
engine.search("greatest of all time").results;
// ${resultLiteral("greatest of all time", { limit: 1 })}`;

const types = `type ResultSource = "alias" | "semantic" | "custom" | "culture";

interface SearchResult {
  emoji: string; // "🦖", or ":shortcode:" for a custom emoji
  id: string; // Emojibase hexcode of the base emoji, "1F996"; "C-<id>" for a custom emoji
  score: number; // 0–1, comparable within one source only
  source: ResultSource;
  imageUrl?: string; // custom emoji: the image to draw
  shortcode?: string; // custom emoji: the shortcode without colons
}

interface AliasResult extends SearchResult {
  source: "alias" | "custom";
  label: string; // the emoji's name
  match: string; // the phrase that matched best
  field: "name" | "shortcode" | "keyword" | "alias" | "typo" | "low";
}

interface CultureResult extends SearchResult {
  source: "culture";
  context: string; // why the emoji fits, in the culture file's language
  cultureId: string; // e.g. "goat-football"
  match: string; // the trigger that matched
  field: "culture";
}

interface AliasSearchOutput {
  query: string; // normalized
  tokens: string[];
  results: (AliasResult | CultureResult)[]; // culture results only with a culture file
  confidence: number; // score of the best canonical result, 0 when nothing matched
}

interface CanonicalSearchOutput extends AliasSearchOutput {
  results: AliasResult[];
}

interface EmojiEntry {
  emoji: string;
  id: string;
  group: string;
  version: number;
  hasSkinTones: boolean;
  labels: Record<string, string>; // per loaded locale
  imageUrl?: string; // custom emoji only
  shortcode?: string; // custom emoji only
}`;

const loader = `function loadPacks(options: {
  baseUrl: string; // "${PACK_URL}"
  locales?: string[]; // default ["en"]; English always loads first
  part?: "core" | "ext"; // default "core"
  fetch?: typeof fetch;
  signal?: AbortSignal;
}): Promise<Pack[]>;

// Your app's custom emoji as a pack, searched on the device next to the standard set.
function loadCustomPack(options: {
  endpoint: string; // the API base URL
  key: string; // publishable key
  tenant?: string; // your customer's external id (tenants, coming soon)
  fetch?: typeof fetch;
  signal?: AbortSignal;
}): Promise<Pack>;`;

const session = `function createSearchSession(options: {
  engine: AliasEngine;
  semantic?: SemanticProvider; // omit for fully offline search
  locale?: string;
  limit?: number; // default 24
  debounceMs?: number; // default 200
  shouldUseSemantic?: (alias: AliasSearchOutput) => boolean;
  culture?: Culture | false; // default: the engine's; false = canonical ranking only
  region?: string; // default: the device's region; "" = none; "BR"; "auto" = the API's view
  now?: () => Date | number; // the clock for culture windows; default Date.now
  onChange: (state: SessionState) => void;
}): { update(query: string): void; dispose(): void };

interface SessionState {
  query: string;
  results: SearchResult[]; // with culture results after the top result
  alias: CanonicalSearchOutput; // the dictionary answer, no culture
  status: "idle" | "alias" | "loading" | "fused" | "error";
  aliasMs: number;
  semanticMs?: number;
  semanticCached?: boolean;
  layer?: "device" | "shard" | "api";
  error?: unknown;
  unsure: boolean; // no tier understood the query: show the results as guesses
  confidence: number; // 0–1
}`;

const providers = `interface SemanticProvider {
  // undefined means "no answer here": the next provider gets the query.
  search(
    query: string,
    options?: { locale?: string; limit?: number; signal?: AbortSignal },
  ): Promise<SemanticResponse | undefined>;
  // An answer already in memory (a loaded shard, an answer seen before), with no I/O.
  // A session shows it at once, with no debounce.
  peek?(query: string, options?: { locale?: string; limit?: number }): SemanticResponse | undefined;
  // Load what peek needs for this query; "" loads the shard indexes only.
  prefetch?(query: string, options?: { locale?: string }): void;
}

// Layer 3, the API (GET /v1/search?mode=semantic)
createSemanticClient({ endpoint: "${API_HOST}", key: "pk_live_…" });

// Layer 2, precomputed results as static files
createShardProvider({ baseUrl: "${SHARDS_URL}" });

// Both, cheapest first. Returns undefined when neither is configured.
createLayeredSemantic({ shardsUrl, endpoint, key, packVersion });

// Any providers, in order: the first answer wins.
chainProviders(shards, api);

// Search reports (emojisense/stats): how searches end and which results are picked,
// one report per page view from 1 in 10 sessions. Off unless you create it.
const stats = createStatsReporter({ endpoint: "https://stats.emojisense.com", key: "pk_live_…" });
createSearchSession({ engine, semantic, onChange: (state) => stats.observe(state) });
stats.pick(query, "1F382");`;

const helpers = `normalize("¡Feliz cumpleaños!"); // "${normalize("¡Feliz cumpleaños!")}"
tokenize(normalize("Ship it!")); // ${JSON.stringify(tokenize(normalize("Ship it!")))}
applySkinTone("👍", "medium-dark"); // "${applySkinTone("👍", "medium-dark")}"
baseId("1F44D-1F3FD"); // "${baseId("1F44D-1F3FD")}"
groupLabel("food-drink", "tr"); // "${groupLabel("food-drink", "tr")}"
hexcodeOf("❤️‍🔥"); // "${hexcodeOf("❤️‍🔥")}"`;

const culture = `// createEngineLoader (emojisense/autocomplete) loads the culture file next to the packs.
createEngineLoader({ packUrl: "${PACK_URL}", locale: "es" });
createEngineLoader({ packUrl: "${PACK_URL}", cultureUrl: false }); // no culture layer

// Without the loader, load the file yourself.
const culture = await loadCulture({ baseUrl: "${API_HOST}/v1/culture/0.1.0", locale: "es" });
const cultured = engine.withCulture(culture); // shares the index

cultured.search("goat", { locale: "es" }).results;
// [🐐 (alias), ⚽ 🇦🇷 🇵🇹 (source "culture", context, cultureId), …]
cultured.search("goat", { culture: false }); // the canonical ranking only
cultured.search("goat", { locale: "es", region: "", day: "2026-10-25" }); // no region, a fixed day

relevantNow(culture, { region: "MX", limit: 8 });
// [{ emoji: "💀", hexcode: "1F480", context: "Día de Muertos, 1 y 2 de noviembre", cultureId: "dia-de-muertos" }, …]`;

const sets = `EMOJI_SETS; // ["native", "twemoji", "noto", "fluent"]
isEmojiSet("noto"); // true

emojiImageUrl("🦖", { endpoint: "${API_HOST}", emojiSet: "noto" });
// "${emojiImageUrl("🦖", { endpoint: API_HOST, emojiSet: "noto" })}"`;
---

<DocsLayout path="/docs/sdk/">
  <p>The <code>emojisense</code> package is the engine every integration is built on. It has no dependencies and runs in browsers, Node, Deno, Bun, Workers and extensions. Everything below is exported from the package root.</p>
  <InstallTabs packages="emojisense" />

  <h2 id="engine">Engine</h2>
  <h3 id="create-engine">createEngine</h3>
  <p>Builds the in-memory dictionary index from one or more packs: several languages, core and extension parts. Searching is synchronous.</p>
  <CodeBlock code={engine} lang="ts" />
  <CodeBlock code={engineExample} lang="ts" title="Example" />
  <ul>
    <li><code>limit</code> defaults to 24. <code>prefix</code> (default <code>true</code>) treats the last word as a prefix while someone types. Pass <code>false</code> for complete queries.</li>
    <li><code>locale</code> prefers phrases from that language’s pack when ranking.</li>
    <li><code>minCoverage</code> (default 0.34) is the share of a multi-word query a phrase must cover.</li>
    <li><code>culture</code>, <code>region</code>, <code>now</code> and <code>day</code> control the <a href="#culture">culture layer</a>. Without a culture file they change nothing.</li>
  </ul>

  <h3 id="types">Result types</h3>
  <CodeBlock code={types} lang="ts" />

  <h2 id="loading">Loading packs</h2>
  <h3 id="load-packs">loadPacks</h3>
  <p>Fetches and validates the packs of one pack version. The files are immutable, so the browser’s HTTP cache does the rest.</p>
  <CodeBlock code={loader} lang="ts" />
  <p><code>loadCustomPack</code> fetches your custom emoji as a pack (<code>part: "custom"</code>, checked with <code>isCustomPack</code>); pass it to <code>createEngine</code> with the other packs. Custom rows use ids that start with <code>CUSTOM_ID_PREFIX</code>, and their results carry <code>imageUrl</code> and <code>shortcode</code>.</p>
  <p><code>assertPack(value)</code> validates a pack you load yourself, for example from your app bundle. <code>PACK_FORMAT</code>, <code>PACK_FORMAT_VERSION</code>, <code>FIELDS</code>, <code>DEFAULT_WEIGHTS</code> and <code>ROW_INDEX</code> describe the format. See <a href="/docs/pack-format/">Pack format</a>.</p>

  <h2 id="sessions">Search sessions</h2>
  <h3 id="create-search-session">createSearchSession</h3>
  <p>The controller behind every picker: dictionary results on every keystroke, then debounced, cancellable meaning results fused in. Stale answers are dropped.</p>
  <CodeBlock code={session} lang="ts" />

  <h2 id="semantic">Semantic providers</h2>
  <p>A provider answers a query or returns <code>undefined</code>, so the next provider gets it. With no provider left, the session keeps the dictionary results.</p>
  <CodeBlock code={providers} lang="ts" />
  <div class="table-scroll" tabindex="0">
    <table>
      <thead><tr><th scope="col">createSemanticClient option</th><th scope="col">Notes</th></tr></thead>
      <tbody>
        <tr><td><code>endpoint</code></td><td>Required. The API base URL.</td></tr>
        <tr><td><code>key</code></td><td>Publishable key, sent as <code>?key=</code> so there is no CORS preflight</td></tr>
        <tr><td><code>packVersion</code></td><td>Pins the data so API results match your packs</td></tr>
        <tr><td><code>cacheSize</code></td><td>In-memory cache of recent answers. Default 200.</td></tr>
        <tr><td><code>overLimitCooldownMs</code></td><td>Skip the API for this long after an over-limit answer. Default 0: keep asking, because the edge cache may still know the next query.</td></tr>
        <tr><td><code>fetch</code></td><td>Your own fetch, for tests or proxies</td></tr>
      </tbody>
    </table>
  </div>
  <p><code>shardKeyFor(keys, query)</code> picks the shard file for a query, for custom shard hosting. Shards are per locale: a search with <code>locale: "tr"</code> reads <code>shardBaseFor(baseUrl, "tr")</code>, which is <code>&lt;baseUrl&gt;/tr</code>; English stays at <code>baseUrl</code>.</p>

  <h2 id="fusion">Fusion</h2>
  <ul>
    <li><code>shouldUseSemantic(alias)</code>: <code>true</code> when the confidence is under 0.6, or for a phrase of two or more words under 0.9.</li>
    <li><code>fuse(alias, semantic, limit, calibration, ranking)</code>: dictionary results with a score of 0.9 or more stay pinned on top, in their order. Every other result of both lists is then ordered by the learned reranker, a linear score over the dictionary score, rank and confidence, the semantic score and its gap to the best one, the semantic confidence and the emoji’s popularity (<a href="/docs/pack-format/">Pack format §10</a>). Pass <code>{"{ popularity: engine.popularity }"}</code> as <code>ranking</code>; a search session does. <code>rerank(input, limit, weights)</code>, <code>rerankFeatures(input, id)</code> and <code>RERANK_WEIGHTS</code> are the reranker itself. Both tiers bring <code>RANK_DEPTH</code> (24) candidates whatever the limit, so a short list is the top of the same ranking.</li>
    <li>With <code>{"{ rerank: false }"}</code> as <code>ranking</code>, <code>fuse</code> merges with weights from the confidence of each tier instead. The dictionary weight is 0.4 + its confidence. The semantic weight goes from 0.4 to 1 as its best cosine goes from <code>calibration.floor</code> to <code>calibration.ceiling</code> (default <code>DEFAULT_SEMANTIC_CALIBRATION</code>, {DEFAULT_SEMANTIC_CALIBRATION.floor}–{DEFAULT_SEMANTIC_CALIBRATION.ceiling}, for EmbeddingGemma at 768 dimensions). Results with a score of 0.9 or more stay pinned on top. When the dictionary is sure (confidence 0.6 or more), its results within 0.1 of its top score come next, in fused order. Semantic country flags that the dictionary results do not hold go last, unless their cosine reaches the calibration ceiling.</li>
    <li><code>semanticConfidence(semantic, calibration)</code>: that 0–1 value. Use your own calibration if you embed with another model.</li>
    <li><code>fuseResults(alias, semantic, options)</code>: the same, with your own <code>k</code> (60), <code>pinScore</code> (0.9), <code>aliasFloor</code> (off), <code>aliasWeight</code> and <code>semanticWeight</code>.</li>
    <li><code>assessConfidence(alias, semantic)</code>: <code>{"{ confidence, unsure }"}</code>. A query is unsure when the dictionary does not cover it with confidence (one phrase matches all its words, <code>alias.coverage</code> 0.85 or more, and the top score is 0.6 or more) and the semantic list is flat or low. The session sets <code>state.unsure</code> with it; show the results as guesses then.</li>
    <li><code>semanticStrength(semantic, calibration)</code>: how strong a semantic list is, 0–1: the best cosine on the calibration scale, halved when it does not stand out from results 2–5. Below <code>SEMANTIC_SURE</code> (0.5) the list is flat or low.</li>
  </ul>

  <h2 id="helpers">Helpers</h2>
  <CodeBlock code={helpers} lang="ts" />
  <ul>
    <li><code>normalize(input, maxLength)</code> and <code>tokenize(normalized)</code> follow the pack format’s normalization. <code>MAX_QUERY_LENGTH</code> is 64. <code>embeddingText(input)</code> is the lighter form the semantic tier embeds: accents, punctuation and emoji stay.</li>
    <li><code>applySkinTone(emoji, tone)</code> with a tone from <code>SKIN_TONES</code>.</li>
    <li><code>baseId(hexcode)</code> maps a skin-tone variant to its base emoji.</li>
    <li><code>groupLabel(group, locale)</code> names a pack group for the UI.</li>
    <li><code>hexcodeOf(emoji)</code> gives the Emojibase hexcode of an emoji, skin tone included.</li>
    <li><code>boundedEditDistance(a, b, max)</code> is the typo distance the engine uses.</li>
    <li><code>COMMON_REACTIONS</code> lists the emoji people react with most (the defaults of Slack, GitHub and Discord), for a reaction bar.</li>
  </ul>

  <h2 id="culture">Culture layer</h2>
  <p>Editorial emoji for a culture, a region and a moment (football’s greatest-of-all-time debate, Día de Muertos, Diwali), from one small file per locale at <code>/v1/culture/&lt;packVersion&gt;/culture.&lt;locale&gt;.json</code>. Editors, helped by AI, write and approve them. They join the results right after the top answer and never replace it.</p>
  <p>The layer is on by default. <code>createEngineLoader</code>, <code>useEmojisense</code>, <code>&lt;emojisense-picker&gt;</code> and the CKEditor 5 and TinyMCE plugins load <code>/v1/culture/&lt;packVersion&gt;</code> next to <code>/v1/pack/&lt;packVersion&gt;</code>. <code>cultureUrl: false</code> turns it off (<code>culture-url="off"</code> on the web component, <code>emojisense_culture_url: "off"</code> in TinyMCE). A missing file changes nothing. A locale whose packs fall back to English uses the English culture file.</p>
  <CodeBlock code={culture} lang="ts" />
  <ul>
    <li><code>loadCulture({"{ baseUrl, locale }"})</code> fetches and checks a culture file (<code>assertCulture</code>, <code>CULTURE_FORMAT</code>, <code>CULTURE_FORMAT_VERSION</code>). Pass it to <code>createEngine(packs, {"{ culture }"})</code> or <code>engine.withCulture(culture)</code>; a search session applies it after fusion. <code>cultureUrlFor(packUrl)</code> gives the culture directory next to a pack version (<code>…/v1/pack/0.1.0</code> → <code>…/v1/culture/0.1.0</code>).</li>
    <li>Culture results have <code>source: "culture"</code>, <code>context</code> (the reason, in the file’s language) and <code>cultureId</code>. Search option <code>culture: false</code> keeps the canonical ranking; <code>region</code> (for example <code>"BR"</code>) selects the regional entries.</li>
    <li>A regional sense (<code>kind: "regional"</code>) is the one entry that can go first: only with a <code>region</code> in its scope, for a query equal to its trigger, and over a canonical answer it names. “football” with <code>region: "GB"</code> gives ⚽ then 🏈; without a region 🏈 stays first. <code>matchRegionalLead(culture, query, topId, {"{ region }"})</code> applies that rule to your own list.</li>
    <li>By default the region is the device’s region: in <code>engine.search</code>, sessions, the React hooks, the web component and the editor plugins. <code>resolveRegion(region, culture)</code> applies the rule: <code>undefined</code> or <code>"device"</code> (<code>DEVICE_REGION</code>) gives the device’s region, <code>""</code> gives none, and any other value stays as given. <code>deviceRegion(zones)</code> returns the region of the browser’s language (<code>navigator.language</code> <code>"pt-BR"</code> → <code>"BR"</code>), else the region of its time zone from the culture file’s <code>zones</code> (<code>"ja"</code> in <code>Asia/Tokyo</code> → <code>"JP"</code>). <code>regionOf(locale)</code> reads the region of any locale tag. The region stays on the device: it only selects regional entries and is never sent.</li>
    <li><code>region: "auto"</code> (<code>AUTO_REGION</code>; <code>isAutoRegion(value)</code> tests for it) is opt-in. It asks the API for the region of the request’s country: the session sends <code>region=auto</code> with its semantic requests and applies regional entries after the first API answer that reports a region.</li>
    <li>Windows are checked against the device’s local day. <code>now</code> sets another clock (<code>createSearchSession</code>, and <code>createSuggestionSource</code> from <code>emojisense/autocomplete</code>). <code>day: "YYYY-MM-DD"</code> fixes the day of one <code>engine.search</code>.</li>
    <li>The semantic client sends <code>culture=0</code>, because the session applies culture on the device, after fusion. Cached answers (shards, the API’s edge cache) hold no culture, so one cached answer serves every region and day.</li>
    <li><code>relevantNow(culture, options)</code> lists featured seasonal and event emoji active today, for an optional shelf.</li>
    <li><code>matchCulture</code>, <code>insertCulture</code> and <code>applyCulture</code> apply a culture file to your own result list; <code>isActiveOn(when, day)</code> and <code>localDay(now)</code> evaluate windows. For a message, such as reaction suggestions, <code>matchCultureInText(culture, text)</code> finds triggers as whole words anywhere in the text, and <code>applyCulture(results, culture, text, {"{ text: true }"})</code> applies them. See <a href="/docs/pack-format/">Pack format §9</a>.</li>
  </ul>

  <h2 id="emoji-sets">Emoji sets</h2>
  <p>For <a href="/docs/guides/emoji-sets/">hosted emoji sets</a>: <code>EMOJI_SETS</code>, <code>isEmojiSet(value)</code> and <code>emojiImageUrl(emoji, {"{ endpoint, emojiSet, key }"})</code>, which returns <code>undefined</code> for <code>native</code> or without an endpoint. Hosted sets need a key on a plan with sets; set <code>EMOJI_IMAGE_REFERRER_POLICY</code> as the <code>referrerpolicy</code> of set images so a publishable key can be checked against your page's origin.</p>
  <CodeBlock code={sets} lang="ts" />

  <h2 id="vectors">Vectors</h2>
  <p>For on-device meaning search experiments and for building vector files, import from <code>emojisense/vectors</code> (a separate entry, so pickers do not ship it): <code>decodeVectors(buffer)</code>, <code>encodeVectors(model, ids, rows)</code>, <code>l2normalize(vector)</code> and <code>searchVectors(index, query, k)</code>. <code>searchVectorSets(indexes, query, k, {"{ bonus }"})</code> searches several vector files at once (for example the shared English file and one locale file), keeps each emoji's best row and adds an optional per-emoji bonus, such as the popularity prior. The file format is in <a href="/docs/pack-format/#5-vectors-vectorsmodeldimsbin-esvec1">Pack format §5</a>.</p>
</DocsLayout>
