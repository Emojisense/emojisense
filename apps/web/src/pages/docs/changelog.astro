---
import DocsLayout from "../../components/docs/DocsLayout.astro";
import { DOCS_PAGES } from "../../lib/docs-nav";

const next = DOCS_PAGES.filter((page) => page.status === "next");
const planned = DOCS_PAGES.filter((page) => page.status === "planned");
const experimental = DOCS_PAGES.filter((page) => page.status === "experimental");
---

<DocsLayout path="/docs/changelog/">
  <p>Release notes live in the <a href="/changelog/">changelog</a>. This page tracks the status of the features these docs describe, so you know what you can build on today.</p>

  {
    next.length > 0 && (
      <>
        <h2 id="coming-in-this-release">Coming in this release</h2>
        <p>The routes are merged and ship with the next deploy of the hosted API.</p>
        <ul>
          {next.map((page) => (
            <li>
              <a href={page.href}>{page.title}</a>: {page.description}
            </li>
          ))}
        </ul>
      </>
    )
  }
  {
    planned.length > 0 && (
      <>
        <h2 id="planned">Planned</h2>
        <p>Designed in the product contract and being built. The API on these pages can still change.</p>
        <ul>
          {planned.map((page) => (
            <li>
              <a href={page.href}>{page.title}</a>: {page.description}
            </li>
          ))}
        </ul>
      </>
    )
  }
  {
    experimental.length > 0 && (
      <>
        <h2 id="experimental">Experimental</h2>
        <ul>
          {experimental.map((page) => (
            <li>
              <a href={page.href}>{page.title}</a>: {page.description}
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2 id="available">Available now</h2>
  <p>Everything else in these docs works today: search on the device and at the edge, reaction suggestions, photo to emoji, keys and limits, and every integration. Integrations that are not in a store yet, such as the Chrome extension and Raycast, say so on their page.</p>
</DocsLayout>
