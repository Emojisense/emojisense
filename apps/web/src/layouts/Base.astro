---
// Self-hosted fonts. Variable fonts cover every weight with one file each.
import "@fontsource/dm-mono/latin-400.css";
import "@fontsource/dm-mono/latin-500.css";
import "@fontsource/dm-mono/latin-ext-400.css";
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource-variable/hanken-grotesk/index.css";
import "../styles/global.css";
import "../i18n/scripts.css";
import ConsentBanner from "../components/ConsentBanner.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { CF_WEB_ANALYTICS_TOKEN, INDEXABLE, SITE_URL } from "../config";
import { DEFAULT_LOCALE, isLocalizedPath, LOCALE_INFO, LOCALES, localizePath } from "../i18n/locales";
import { i18nFor } from "../i18n/page";
import { shareCardFor } from "../og/registry";
import { HEIGHT as CARD_HEIGHT, WIDTH as CARD_WIDTH } from "../og/svg";

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description: string;
  /**
   * English path of this page, e.g. "/pricing/". Used for the canonical URL, the language
   * alternates and the active nav item. The page's language comes from its URL.
   */
  path: string;
  /** Structured data (schema.org) for search engines. */
  jsonLd?: Record<string, unknown>;
  /** Open Graph type. Docs, legal pages and the changelog are articles; the rest is the website. */
  ogType?: "website" | "article";
}

const { title, description, path, jsonLd } = Astro.props;
const NOT_FOUND_PATH = "/404/";
const ogType =
  Astro.props.ogType ?? (/^\/(docs\/.+|legal\/.+|changelog\/)/.test(path) ? "article" : "website");
const { t, locale } = i18nFor(Astro);
const info = LOCALE_INFO[locale];
const fullTitle = title ? `${title} · Emojisense` : t("meta.homeTitle");
const canonical = `${SITE_URL}${localizePath(path, locale)}`;
// Each page has its own card in its own language (src/og/registry.ts).
const shareCard = shareCardFor(path, locale);
const shareImageUrl = `${SITE_URL}${shareCard.image}`;
const shareAlt = shareCard.alt;
// Pages in every language list each other; English-only pages have no alternates.
const alternates = isLocalizedPath(path)
  ? LOCALES.map((code) => ({
      hreflang: LOCALE_INFO[code].tag,
      href: `${SITE_URL}${localizePath(path, code)}`,
    }))
  : [];
---

<!doctype html>
<html lang={info.tag} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.length > 0 && (
        <>
          {alternates.map((alternate) => (
            <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${localizePath(path, DEFAULT_LOCALE)}`} />
        </>
      )
    }
    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0f" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Emojisense" />
    <meta property="og:locale" content={info.og} />
    {
      alternates.length > 0 &&
        LOCALES.filter((code) => code !== locale).map((code) => (
          <meta property="og:locale:alternate" content={LOCALE_INFO[code].og} />
        ))
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(CARD_WIDTH)} />
    <meta property="og:image:height" content={String(CARD_HEIGHT)} />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareAlt} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      // Not on the 404 page: its URL is what the visitor typed (privacy policy, "The website").
      CF_WEB_ANALYTICS_TOKEN && path !== NOT_FOUND_PATH && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_WEB_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t("meta.skipLink")}</a>
    <Nav path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer path={path} />
    <ConsentBanner reportPath={path === NOT_FOUND_PATH ? NOT_FOUND_PATH : undefined} />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    inset-inline-start: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    border-radius: var(--pill);
    background: var(--brand);
    color: var(--on-brand);
    font-weight: 700;
  }

  .skip-link:focus {
    top: 1rem;
  }

  main:focus {
    outline: none;
  }
</style>
