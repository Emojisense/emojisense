---
import { CultureLens } from "../islands/CultureLens";
import { cultureShowcase } from "../lib/culture";

const { source, today, queries, calendar } = cultureShowcase();

const steps = [
  {
    emoji: "🤖",
    title: "AI proposes",
    body: "It drafts associations from holiday calendars, big events and new slang.",
  },
  {
    emoji: "👀",
    title: "An editor decides",
    body: "A person reviews every one. Nothing goes live without that approval.",
  },
  {
    emoji: "🔎",
    title: "Search adds it",
    body: "Approved emoji join the results after the top answer, and step aside when their moment ends.",
  },
];
---

<section
  id="culture"
  class="section section-soft"
  aria-labelledby="culture-title"
  data-culture-source={source}
>
  <div class="container">
    <div class="section-head">
      <p class="kicker">Culture <span class="new">New</span></p>
      <h2 id="culture-title">Emoji meaning is cultural. And culture moves.</h2>
      <p class="lead">
        Our editors, helped by AI, map what emoji mean across cultures and moments — and keep it current. It adds
        to the answer; it never replaces it.
      </p>
    </div>

    {queries.length > 0 && <CultureLens client:visible queries={queries} calendar={calendar} today={today} />}

    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <span class="emoji" aria-hidden="true">
              {s.emoji}
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .new {
    padding: 0.1875rem 0.5rem;
    border: 0.0625rem solid var(--line-strong);
    border-radius: var(--pill);
    background: var(--bg);
    color: var(--ink-2);
    font-size: 0.6875rem;
  }

  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .steps li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-content: start;
    gap: 0.375rem 0.75rem;
    padding-top: 1.25rem;
    border-top: 0.0625rem solid var(--line-strong);
  }

  .steps .emoji {
    font-size: 1.375rem;
    line-height: 1.5rem;
  }

  .steps h3 {
    font-size: 1.0625rem;
    line-height: 1.5rem;
  }

  .steps p {
    grid-column: 2;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>
