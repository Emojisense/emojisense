---
import { cultureLocaleFor } from "../i18n/culture";
import { i18nFor } from "../i18n/page";
import { CultureLens } from "../islands/CultureLens";
import cultureLensCss from "../islands/culture-lens.css?url";
import { cultureShowcase } from "../lib/culture";

const { t, locale, tag, messages } = i18nFor(Astro);
const { source, today, queries, calendar } = cultureShowcase(cultureLocaleFor(locale));

const steps = [
  { emoji: "🤖", title: t("culture.steps.ai.title"), body: t("culture.steps.ai.body") },
  { emoji: "👀", title: t("culture.steps.editor.title"), body: t("culture.steps.editor.body") },
  { emoji: "🔎", title: t("culture.steps.search.title"), body: t("culture.steps.search.body") },
];
---

<section
  id="culture"
  class="section section-soft"
  aria-labelledby="culture-title"
  data-culture-source={source}
>
  <div class="container">
    <div class="section-head">
      <p class="kicker">{t("culture.kicker")} <span class="new">{t("culture.tag")}</span></p>
      <h2 id="culture-title">{t("culture.title")}</h2>
      <p class="lead">{t("culture.lead")}</p>
    </div>

    {
      queries.length > 0 && (
        <>
          {/* Far below the fold: the lens styles load with it, without blocking the first paint. */}
          <link rel="stylesheet" href={cultureLensCss} media="print" data-deferred-style />
          <noscript>
            <link rel="stylesheet" href={cultureLensCss} />
          </noscript>
          <CultureLens
            client:visible
            queries={queries}
            calendar={calendar}
            today={today}
            messages={messages.culture.lens}
            lang={tag}
            queryLang={locale === "en" ? undefined : "en"}
          />
        </>
      )
    }

    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <span class="emoji" aria-hidden="true">
              {s.emoji}
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // Turns the print-only lens styles on once loaded. A script, not onload="", because the
  // Content-Security-Policy blocks inline event handlers.
  for (const link of document.querySelectorAll<HTMLLinkElement>("link[data-deferred-style]")) {
    const show = () => {
      link.media = "all";
    };
    if (link.sheet) show();
    else link.addEventListener("load", show, { once: true });
  }
</script>

<style>
  .new {
    padding: 0.1875rem 0.5rem;
    border: 0.0625rem solid var(--line-strong);
    border-radius: var(--pill);
    background: var(--bg);
    color: var(--ink-2);
    font-size: 0.6875rem;
  }

  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .steps li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-content: start;
    gap: 0.375rem 0.75rem;
    padding-top: 1.25rem;
    border-top: 0.0625rem solid var(--line-strong);
  }

  .steps .emoji {
    font-size: 1.375rem;
    line-height: 1.5rem;
  }

  .steps h3 {
    font-size: 1.0625rem;
    line-height: 1.5rem;
  }

  .steps p {
    grid-column: 2;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>
