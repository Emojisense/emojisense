---
import { PLAN_IDS, PLANS } from "@emojisense/platform";
import { REPO_URL } from "../../config";

/** config.ts has no sales address yet, so custom requests go to GitHub Discussions. */
const contactUrl = `${REPO_URL}/discussions`;
const topPlan = PLANS[PLAN_IDS[PLAN_IDS.length - 1] ?? "scale"].name;
const openParts = ["Engine", "SDKs", "Data pack", "API server", "Dashboard"];
---

<section class="section beyond" aria-labelledby="beyond-title">
  <div class="container">
    <h2 id="beyond-title" class="visually-hidden">Self-hosting and custom plans</h2>
    <div class="beyond-grid">
      <article class="beyond-card beyond-oss">
        <p class="kicker"><span class="emoji" aria-hidden="true">🧰</span> Open source</p>
        <h3>Prefer to run it yourself?</h3>
        <p>
          The core of Emojisense is MIT. Run it on your own Cloudflare account with no license fee, and pay
          Cloudflare directly. Hosted plans add daily dictionary updates, analytics, hosted emoji sets and zero
          operations.
        </p>
        <ul class="beyond-parts" aria-label="MIT-licensed parts">
          {openParts.map((part) => <li>{part}</li>)}
        </ul>
        <div class="beyond-links">
          <a class="btn btn-secondary" href="/docs/self-host/">Self-host guide</a>
          <a class="beyond-link" href={REPO_URL}>View on GitHub <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="beyond-card">
        <p class="kicker"><span class="emoji" aria-hidden="true">🏗️</span> Custom</p>
        <h3>Need more than {topPlan}?</h3>
        <p>
          Higher limits, many tenants, or a setup that does not fit a plan? Tell us what you are building.
        </p>
        <div class="beyond-links">
          <a class="btn btn-secondary" href={contactUrl}>Start a conversation</a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .beyond-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  @media (min-width: 56rem) {
    .beyond-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }

  .beyond-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--bg);
  }

  .beyond-oss {
    background: var(--bg-soft);
  }

  .kicker {
    margin-bottom: 0.25rem;
  }

  .kicker .emoji {
    font-size: 1rem;
  }

  h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
  }

  .beyond-card > p:not(.kicker) {
    max-width: 36rem;
    color: var(--ink-2);
  }

  .beyond-parts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .beyond-parts li {
    padding: 0.3125rem 0.625rem;
    border: 0.0625rem solid var(--line-strong);
    border-radius: var(--pill);
    background: var(--bg);
    color: var(--ink-2);
    font: 400 0.8125rem / 1.2 var(--font-mono);
  }

  .beyond-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .beyond-link {
    color: var(--ink);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .beyond-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
