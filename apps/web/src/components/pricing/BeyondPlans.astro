---
import { LISTED_PLAN_IDS, PLANS } from "@emojisense/platform";
import { REPO_URL } from "../../config";
import { i18nFor } from "../../i18n/page";

/** config.ts has no sales address yet, so custom requests go to GitHub Discussions. */
const contactUrl = `${REPO_URL}/discussions`;
const topPlan = PLANS[LISTED_PLAN_IDS.at(-1) ?? "pro"].name;
const { t, locale } = i18nFor(Astro);
const openParts = [
  t("pricing.beyond.oss.parts.engine"),
  t("pricing.beyond.oss.parts.sdks"),
  t("pricing.beyond.oss.parts.pack"),
  t("pricing.beyond.oss.parts.api"),
  t("pricing.beyond.oss.parts.dashboard"),
];
---

<section class="section beyond" aria-labelledby="beyond-title">
  <div class="container">
    <h2 id="beyond-title" class="visually-hidden">{t("pricing.beyond.title")}</h2>
    <div class="beyond-grid">
      <article class="beyond-card beyond-oss">
        <p class="kicker"><span class="emoji" aria-hidden="true">🧰</span> {t("pricing.beyond.oss.kicker")}</p>
        <h3>{t("pricing.beyond.oss.title")}</h3>
        <p>{t("pricing.beyond.oss.body")}</p>
        <ul class="beyond-parts" aria-label={t("pricing.beyond.oss.partsLabel")}>
          {openParts.map((part) => <li>{part}</li>)}
        </ul>
        <div class="beyond-links">
          <a class="btn btn-secondary" href="/docs/self-host/" hreflang={locale === "en" ? undefined : "en"}>
            {t("pricing.beyond.oss.guide")}
          </a>
          <a class="beyond-link" href={REPO_URL}>
            {t("pricing.beyond.oss.github")} <span class="flip-rtl" aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <article class="beyond-card">
        <p class="kicker"><span class="emoji" aria-hidden="true">🏗️</span> {t("pricing.beyond.custom.kicker")}</p>
        <h3>{t("pricing.beyond.custom.title", { plan: topPlan })}</h3>
        <p>{t("pricing.beyond.custom.body")}</p>
        <div class="beyond-links">
          <a class="btn btn-secondary" href={contactUrl}>{t("pricing.beyond.custom.cta")}</a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .beyond-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  @media (min-width: 56rem) {
    .beyond-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }

  .beyond-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--bg);
  }

  .beyond-oss {
    background: var(--bg-soft);
  }

  .kicker {
    margin-bottom: 0.25rem;
  }

  .kicker .emoji {
    font-size: 1rem;
  }

  h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
  }

  .beyond-card > p:not(.kicker) {
    max-width: 36rem;
    color: var(--ink-2);
  }

  .beyond-parts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .beyond-parts li {
    padding: 0.3125rem 0.625rem;
    border: 0.0625rem solid var(--line-strong);
    border-radius: var(--pill);
    background: var(--bg);
    color: var(--ink-2);
    font: 400 0.8125rem / 1.2 var(--font-mono);
  }

  .beyond-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .beyond-link {
    color: var(--ink);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .beyond-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
