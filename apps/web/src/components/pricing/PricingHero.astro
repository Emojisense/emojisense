---
import { i18nFor } from "../../i18n/page";
import Pricing from "../Pricing.astro";

const { t, parts } = i18nFor(Astro);
const assurances = [
  t("pricing.hero.assurances.card"),
  t("pricing.hero.assurances.failure"),
  t("pricing.hero.assurances.mit"),
];
---

<section class="pricing-hero" aria-labelledby="pricing-title">
  <div class="container">
    <div class="pricing-hero-head">
      <p class="kicker"><span class="emoji" aria-hidden="true">💸</span> {t("pricing.hero.kicker")}</p>
      <h1 id="pricing-title">
        {parts("pricing.hero.title").map((part) => (part.tag === "line" ? <span>{part.text}</span> : part.text))}
      </h1>
      <p class="lead">{t("pricing.hero.lead")}</p>
    </div>
    <Pricing headingLevel={2} />
    <ul class="pricing-assurances">
      {
        assurances.map((item) => (
          <li>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="m3.5 8.5 3 3 6-7" />
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pricing-hero {
    padding: clamp(3.5rem, 8vw, 6rem) 0 clamp(1rem, 3vw, 2rem);
    background: radial-gradient(60rem 26rem at 50% -8rem, var(--bg-soft), transparent 70%);
  }

  .pricing-hero-head {
    display: grid;
    justify-items: center;
    max-width: 46rem;
    margin: 0 auto clamp(2rem, 4vw, 2.75rem);
    text-align: center;
  }

  h1 {
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 4.75rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  h1 span {
    display: inline-block;
  }

  .lead {
    max-width: 38rem;
    margin-top: 1.25rem;
  }

  .pricing-assurances {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .pricing-assurances li {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
  }

  .pricing-assurances svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
