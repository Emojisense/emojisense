---
import { DASHBOARD_URL, REPO_URL } from "../config";
import { LEGAL_PAGES } from "../content/legal";
import { packFacts } from "../lib/pack-facts";

interface FooterLink {
  href: string;
  label: string;
}

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: "Product",
    links: [
      { href: "/#use-cases", label: "Use cases" },
      { href: "/#features", label: "Features" },
      { href: "/#integrations", label: "Integrations" },
      { href: "/playground/", label: "Playground" },
      { href: "/pricing/", label: "Pricing" },
    ],
  },
  {
    title: "Developers",
    links: [
      { href: "/docs/", label: "Docs" },
      { href: "/docs/quickstart/", label: "Quickstart" },
      { href: "/docs/api/", label: "HTTP API" },
      { href: "/docs/self-host/", label: "Self-host" },
      { href: "/docs/privacy/", label: "How data flows" },
      { href: REPO_URL, label: "GitHub" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/about/", label: "About" },
      { href: "/changelog/", label: "Changelog" },
      { href: `${REPO_URL}/issues`, label: "Report an issue" },
      { href: `${DASHBOARD_URL}/`, label: "Sign in" },
    ],
  },
  {
    title: "Legal",
    links: LEGAL_PAGES.map((page) => ({ href: page.href, label: page.label })),
  },
];

const isExternal = (href: string) => /^https?:\/\//.test(href) && !href.startsWith(DASHBOARD_URL);
const number = new Intl.NumberFormat("en");
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Emojisense home">
        <span class="footer-logo-mark emoji" aria-hidden="true">🦖</span>
        <span class="footer-logo-word">emojisense</span>
      </a>
      <p class="footer-tagline">The complete emoji platform for every app.</p>

      <a class="footer-oss" href={REPO_URL}>
        <span class="footer-oss-head">
          <span class="footer-oss-dot" aria-hidden="true"></span>
          Open-source core
          <span class="footer-oss-license">MIT</span>
        </span>
        <span class="footer-oss-body">The engine, data packs, SDKs and API server are open source. Self-host them, or use ours.</span>
        {
          packFacts && (
            <span class="footer-oss-meta">
              pack {packFacts.packVersion} · Emoji {packFacts.emojiVersion} · {number.format(packFacts.emojiCount)} emoji ·{" "}
              {packFacts.languages} languages
            </span>
          )
        }
      </a>
    </div>

    <nav class="footer-columns" aria-label="Footer">
      {
        columns.map((column) => (
          <div class="footer-column">
            <p class="footer-column-title">{column.title}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>
                    {link.label}
                    {isExternal(link.href) && (
                      <svg class="footer-external" viewBox="0 0 12 12" aria-hidden="true">
                        <path d="M4 3h5v5M9 3 3.5 8.5" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {year} Emojisense</p>
    <p>
      Emoji data from{" "}
      <a href="https://emojibase.dev">Emojibase</a>{packFacts?.emojibaseVersion && ` ${packFacts.emojibaseVersion}`}{" "}
      (MIT) and <a href="https://cldr.unicode.org">Unicode CLDR</a>{packFacts?.cldrVersion && ` ${packFacts.cldrVersion}`}{" "}
      (Unicode License v3). Emoji render in your system font.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 0.0625rem solid var(--line);
    background: var(--bg-soft);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .footer-top {
    display: grid;
    gap: 3rem;
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .footer-brand {
    display: grid;
    align-content: start;
    gap: 1rem;
    max-width: 22rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    color: var(--ink);
    text-decoration: none;
  }

  .footer-logo-mark {
    font-size: 1.375rem;
    transition: transform 240ms var(--spring);
  }

  .footer-logo:hover .footer-logo-mark {
    transform: rotate(-10deg) scale(1.08);
  }

  .footer-logo-word {
    font: 700 1.125rem / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .footer-tagline {
    color: var(--ink-2);
  }

  .footer-oss {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.5rem;
    padding: 1rem 1.125rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition:
      border-color 160ms,
      transform 200ms var(--ease-out);
  }

  .footer-oss:hover {
    border-color: var(--line-strong);
    transform: translateY(-0.0625rem);
  }

  .footer-oss-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-weight: 600;
  }

  .footer-oss-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--pill);
    background: var(--live);
    box-shadow: 0 0 0 0.1875rem color-mix(in srgb, var(--live) 18%, transparent);
  }

  .footer-oss-license {
    margin-left: auto;
    padding: 0.125rem 0.5rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--pill);
    color: var(--ink-2);
    font: 500 0.75rem / 1.4 var(--font-mono);
  }

  .footer-oss-body {
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .footer-oss-meta {
    color: var(--ink-3);
    font: 400 0.75rem / 1.5 var(--font-mono);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }

  .footer-column-title {
    margin-bottom: 0.875rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .footer-column ul {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 160ms;
  }

  .footer-column a:hover {
    color: var(--ink);
  }

  .footer-external {
    width: 0.6875rem;
    height: 0.6875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.6;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 0.0625rem solid var(--line);
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .footer-bottom p:last-child {
    max-width: 44rem;
  }

  .footer-bottom a {
    color: inherit;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .footer-bottom a:hover {
    color: var(--ink-2);
  }

  @media (min-width: 40rem) {
    .footer-columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .footer-top {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
