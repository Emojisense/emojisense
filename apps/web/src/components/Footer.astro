---
import { DASHBOARD_URL, REPO_URL } from "../config";

const columns = [
  {
    title: "Product",
    links: [
      { href: "/#features", label: "Features" },
      { href: "/#languages", label: "Languages" },
      { href: "/pricing/", label: "Pricing" },
      { href: "/waitlist/", label: "Pro waitlist" },
    ],
  },
  {
    title: "Developers",
    links: [
      { href: "/docs/", label: "Quickstart" },
      { href: "/docs/api/", label: "HTTP API" },
      { href: "/docs/self-host/", label: "Self-host" },
      { href: REPO_URL, label: "GitHub" },
    ],
  },
  {
    title: "Account",
    links: [
      { href: `${DASHBOARD_URL}/`, label: "Sign in" },
      { href: `${DASHBOARD_URL}/`, label: "Get an API key" },
      { href: "/docs/privacy/", label: "Privacy" },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="brand">
      <a class="logo" href="/">
        <span class="logo-mark emoji" aria-hidden="true">🦖</span>
        <span class="logo-word">emojisense</span>
      </a>
      <p>Emoji search that understands what people mean. Open source at the core.</p>
    </div>
    {
      columns.map((column) => (
        <div class="col">
          <p class="col-title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container legal">
    <p>
      © 2026 Emojisense · Code MIT · Emoji data from Emojibase (MIT) and Unicode CLDR (Unicode License v3). Emoji
      render in your system font.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 0.0625rem solid var(--line);
    background: var(--bg-soft);
    padding-top: 3.5rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 2rem;
  }

  .brand {
    grid-column: span 2;
    max-width: 22rem;
  }

  .brand p {
    margin-top: 0.75rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.625rem;
    background: var(--brand);
    font-size: 1.125rem;
  }

  .logo-word {
    font: 800 1.125rem / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .col-title {
    margin-bottom: 0.75rem;
    font-weight: 700;
    font-size: 0.875rem;
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    color: var(--ink-2);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  ul a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .legal {
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 0.0625rem solid var(--line);
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  @media (max-width: 40rem) {
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
