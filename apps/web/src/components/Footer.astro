---
import { DASHBOARD_URL, GA_MEASUREMENT_ID, REPO_URL } from "../config";
import { LEGAL_PAGES } from "../content/legal";
import LanguageSwitcher from "../i18n/LanguageSwitcher.astro";
import { DEFAULT_LOCALE, isLocalizedPath } from "../i18n/locales";
import { i18nFor } from "../i18n/page";
import { packFacts } from "../lib/pack-facts";

interface Props {
  /** English path of the current page. */
  path: string;
}

interface FooterLink {
  href: string;
  label: string;
}

const { path } = Astro.props;
const { t, parts, href, locale, tag } = i18nFor(Astro);

const LEGAL_LABELS: Record<string, string> = {
  "/legal/terms/": t("footer.links.terms"),
  "/legal/privacy/": t("footer.links.privacy"),
  "/legal/acceptable-use/": t("footer.links.acceptableUse"),
  "/legal/subprocessors/": t("footer.links.subprocessors"),
};

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: t("footer.columns.product"),
    links: [
      { href: "/#use-cases", label: t("footer.links.useCases") },
      { href: "/#features", label: t("footer.links.features") },
      { href: "/integrations/", label: t("footer.links.integrations") },
      { href: "/playground/", label: t("footer.links.playground") },
      { href: "/pricing/", label: t("footer.links.pricing") },
    ],
  },
  {
    title: t("footer.columns.developers"),
    links: [
      { href: "/docs/", label: t("footer.links.docs") },
      { href: "/docs/quickstart/", label: t("footer.links.quickstart") },
      { href: "/docs/api/", label: t("footer.links.httpApi") },
      { href: "/docs/self-host/", label: t("footer.links.selfHost") },
      { href: "/docs/privacy/", label: t("footer.links.dataFlows") },
      { href: REPO_URL, label: "GitHub" },
    ],
  },
  {
    title: t("footer.columns.company"),
    links: [
      { href: "/about/", label: t("footer.links.about") },
      { href: "/changelog/", label: t("footer.links.changelog") },
      { href: `${REPO_URL}/issues`, label: t("footer.links.reportIssue") },
      { href: `${DASHBOARD_URL}/`, label: t("footer.links.signIn") },
    ],
  },
  {
    title: t("footer.columns.legal"),
    links: LEGAL_PAGES.map((page) => ({ href: page.href, label: LEGAL_LABELS[page.href] ?? page.label })),
  },
];

const isExternal = (url: string) => /^https?:\/\//.test(url) && !url.startsWith(DASHBOARD_URL);
/** On a translated page, a site link to an English-only page says so. */
const isEnglishOnly = (url: string) =>
  locale !== DEFAULT_LOCALE && url.startsWith("/") && !isLocalizedPath(url);
const number = new Intl.NumberFormat(tag);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="footer-logo" href={href("/")} aria-label={t("nav.home")}>
        <span class="footer-logo-mark emoji" aria-hidden="true">🦖</span>
        <span class="footer-logo-word">emojisense</span>
      </a>
      <p class="footer-tagline">{t("footer.tagline")}</p>

      <a class="footer-oss" href={REPO_URL}>
        <span class="footer-oss-head">
          <span class="footer-oss-dot" aria-hidden="true"></span>
          {t("footer.ossTitle")}
          <span class="footer-oss-license">MIT</span>
        </span>
        <span class="footer-oss-body">{t("footer.ossBody")}</span>
        {
          packFacts && (
            <span class="footer-oss-meta">
              {t("footer.ossMeta", {
                pack: packFacts.packVersion,
                emojiVersion: packFacts.emojiVersion,
                count: number.format(packFacts.emojiCount),
                languages: number.format(packFacts.languages),
              })}
            </span>
          )
        }
      </a>

      <div class="footer-lang">
        <LanguageSwitcher path={path} variant="list" />
        {locale !== DEFAULT_LOCALE && <p class="footer-lang-note">{t("language.englishOnly")}</p>}
      </div>
    </div>

    <nav class="footer-columns" aria-label={t("footer.label")}>
      {
        columns.map((column) => (
          <div class="footer-column">
            <p class="footer-column-title">{column.title}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={href(link.href)} hreflang={isEnglishOnly(link.href) ? "en" : undefined}>
                    {link.label}
                    {isEnglishOnly(link.href) && (
                      <span class="lang-hint">
                        <span aria-hidden="true">EN</span>
                        <span class="visually-hidden">{t("nav.inEnglish")}</span>
                      </span>
                    )}
                    {isExternal(link.href) && (
                      <svg class="footer-external" viewBox="0 0 12 12" aria-hidden="true">
                        <path d="M4 3h5v5M9 3 3.5 8.5" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>
      {t("footer.copyright", { year: String(year) })}
      {
        GA_MEASUREMENT_ID && (
          <button type="button" class="footer-consent" data-consent-open hidden>
            {t("consent.settings")}
          </button>
        )
      }
    </p>
    <p>
      {
        parts("footer.credits", {
          emojibaseVersion: packFacts?.emojibaseVersion ? ` ${packFacts.emojibaseVersion}` : "",
          cldrVersion: packFacts?.cldrVersion ? ` ${packFacts.cldrVersion}` : "",
        }).map((part) =>
          part.tag === "emojibase" ? (
            <a href="https://emojibase.dev">{part.text}</a>
          ) : part.tag === "cldr" ? (
            <a href="https://cldr.unicode.org">{part.text}</a>
          ) : (
            part.text
          ),
        )
      }
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 0.0625rem solid var(--line);
    background: var(--bg-soft);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .footer-top {
    display: grid;
    gap: 3rem;
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .footer-brand {
    display: grid;
    align-content: start;
    gap: 1rem;
    max-width: 22rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    color: var(--ink);
    text-decoration: none;
  }

  .footer-logo-mark {
    font-size: 1.375rem;
    transition: transform 240ms var(--spring);
  }

  .footer-logo:hover .footer-logo-mark {
    transform: rotate(-10deg) scale(1.08);
  }

  .footer-logo-word {
    font: 700 1.125rem / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .footer-tagline {
    color: var(--ink-2);
  }

  .footer-oss {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.5rem;
    padding: 1rem 1.125rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition:
      border-color 160ms,
      transform 200ms var(--ease-out);
  }

  .footer-oss:hover {
    border-color: var(--line-strong);
    transform: translateY(-0.0625rem);
  }

  .footer-oss-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-weight: 600;
  }

  .footer-oss-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--pill);
    background: var(--live);
    box-shadow: 0 0 0 0.1875rem color-mix(in srgb, var(--live) 18%, transparent);
  }

  .footer-oss-license {
    margin-inline-start: auto;
    padding: 0.125rem 0.5rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--pill);
    color: var(--ink-2);
    font: 500 0.75rem / 1.4 var(--font-mono);
  }

  .footer-oss-body {
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .footer-oss-meta {
    color: var(--ink-3);
    font: 400 0.75rem / 1.5 var(--font-mono);
  }

  .footer-lang {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }

  .footer-lang-note {
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }

  .footer-column-title {
    margin-bottom: 0.875rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .footer-column ul {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 160ms;
  }

  .footer-column a:hover {
    color: var(--ink);
  }

  .footer-external {
    width: 0.6875rem;
    height: 0.6875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.6;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 0.0625rem solid var(--line);
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .footer-bottom p:last-child {
    max-width: 44rem;
  }

  .footer-bottom a {
    color: inherit;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .footer-bottom a:hover {
    color: var(--ink-2);
  }

  .footer-consent {
    margin-inline-start: 1rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .footer-consent:hover {
    color: var(--ink-2);
  }

  .footer-consent[hidden] {
    display: none;
  }

  @media (min-width: 40rem) {
    .footer-columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .footer-top {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
