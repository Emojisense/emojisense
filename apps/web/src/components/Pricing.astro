---
import { DASHBOARD_URL } from "../config";
import { formatListIn } from "../i18n/format";
import { i18nFor } from "../i18n/page";
import { pricingLocaleFor } from "../i18n/pricing";
import { planViews, yearlySavingsPercent } from "../lib/pricing";
import { FEATURED_PLAN, PLAN_COPY } from "./pricing/plan-copy";

interface Props {
  /** Show the monthly / yearly switch. It appears only when a plan bills yearly. */
  billingToggle?: boolean;
  /** Level of the plan names: 3 under a section h2, 2 when the cards sit right under the page h1. */
  headingLevel?: 2 | 3;
}

const { billingToggle = true, headingLevel = 3 } = Astro.props;
const PlanName = `h${headingLevel}` as const;
const { t, parts, href, locale, tag } = i18nFor(Astro);
const plans = planViews(DASHBOARD_URL, undefined, pricingLocaleFor(locale));
const yearlyNames = plans.filter((plan) => plan.yearly).map((plan) => plan.name);
const savings = yearlySavingsPercent();
const showToggle = billingToggle && yearlyNames.length > 0;
const yearlyList = formatListIn(tag, yearlyNames);
const percent = new Intl.NumberFormat(tag).format(savings);
---

<div class="pricing">
  {
    showToggle && (
      <div class="billing-wrap">
        <fieldset class="billing">
          <legend class="visually-hidden">{t("plans.billingPeriod")}</legend>
          <label>
            <input type="radio" name="billing" value="monthly" checked />
            <span>{t("plans.monthly")}</span>
          </label>
          <label>
            <input type="radio" name="billing" value="yearly" />
            <span>{t("plans.yearly")}</span>
            {savings > 0 && <span class="save">{t("plans.savePercent", { percent })}</span>}
          </label>
        </fieldset>
        <p class="billing-note">{t("plans.yearlyNote", { plans: yearlyList })}</p>
      </div>
    )
  }

  <div class="plans">
    {
      plans.map((plan) => {
        const copy = PLAN_COPY[plan.id];
        const featured = plan.id === FEATURED_PLAN;
        return (
          <article
            class:list={["plan", { featured }]}
            data-plan={plan.id}
            data-price-monthly={plan.monthlyUsd}
            aria-labelledby={`plan-${plan.id}`}
          >
            <div class="plan-top">
              <span class="plan-emoji emoji" aria-hidden="true">
                {copy.emoji}
              </span>
              {featured && <p class="badge">{t("plans.recommended")}</p>}
            </div>
            <PlanName id={`plan-${plan.id}`} class="plan-name">
              {plan.name}
            </PlanName>
            <p class="blurb">{t(`plans.blurbs.${plan.id}`)}</p>
            <p class="price">
              <span class:list={["amount", { "when-monthly": plan.yearly }]}>{plan.monthly}</span>
              {plan.yearly && <span class="amount amount-yearly when-yearly">{plan.yearlyPerMonth}</span>}
              <span class="per">{t("plans.perMonth")}</span>
            </p>
            <p class="price-alt" data-price-yearly={plan.yearly?.raw}>
              {plan.yearly ? (
                <>
                  <span class="when-monthly">
                    {t("plans.orYearly", { price: plan.yearly.price, savings: plan.yearly.savings })}
                  </span>
                  <span class="when-yearly">
                    {t("plans.billedYearly", { price: plan.yearly.price, savings: plan.yearly.savings })}
                  </span>
                </>
              ) : plan.monthlyUsd === 0 ? (
                t("plans.noCard")
              ) : (
                t("plans.billedMonthly")
              )}
            </p>
            <a
              class:list={["btn", "plan-cta", featured ? "btn-primary" : "btn-secondary", { "cta-monthly": plan.cta.yearlyHref }]}
              href={plan.cta.href}
            >
              {plan.cta.label}
            </a>
            {plan.cta.yearlyHref && (
              <a
                class:list={["btn", "plan-cta", "cta-yearly", featured ? "btn-primary" : "btn-secondary"]}
                href={plan.cta.yearlyHref}
              >
                {plan.cta.label}
                <span class="visually-hidden"> {t("plans.yearlyHint")}</span>
              </a>
            )}
            <p class="includes">{plan.inherits ? t("plans.everythingIn", { plan: plan.inherits }) : t("plans.includes")}</p>
            <ul>
              {plan.highlights.map((feature) => (
                <li data-feature={feature.key} data-raw={feature.raw}>
                  <svg class="check" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="m3.5 8.5 3 3 6-7" />
                  </svg>
                  <span>
                    {typeof feature.value === "string" ? (
                      <>
                        <strong>{feature.value}</strong> {feature.unit ?? feature.label}
                      </>
                    ) : (
                      feature.label
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>

  <p class="fine" id="limits">
    <span class="emoji" aria-hidden="true">🛟</span>
    {
      parts("plans.fine").map((part) =>
        part.tag === "strong" ? (
          <strong>{part.text}</strong>
        ) : part.tag === "link" ? (
          <a href={href("/pricing/#calls")}>{part.text}</a>
        ) : (
          part.text
        ),
      )
    }
  </p>
</div>

<style>
  .pricing {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* Billing switch: two radios styled as a segmented control. No JavaScript. */
  .billing-wrap {
    display: grid;
    justify-items: center;
    gap: 0.625rem;
  }

  .billing {
    display: inline-flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--pill);
    background: var(--bg-soft);
  }

  .billing label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 1.125rem;
    border-radius: var(--pill);
    color: var(--ink-2);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      background 200ms var(--ease-out),
      color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out);
  }

  .billing label:hover {
    color: var(--ink);
  }

  .billing input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .billing label:has(input:checked) {
    background: var(--bg);
    color: var(--ink);
    box-shadow:
      var(--shadow-sm),
      0 0 0 0.0625rem var(--line);
  }

  .billing label:has(input:focus-visible) {
    outline: 0.1875rem solid var(--focus);
    outline-offset: 0.125rem;
  }

  .save {
    padding: 0.125rem 0.4375rem;
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--good) 14%, transparent);
    color: var(--good);
    font: 500 0.75rem / 1.2 var(--font-mono);
  }

  .billing-note {
    color: var(--ink-3);
    font-size: 0.8125rem;
    visibility: hidden;
  }

  .when-yearly {
    display: none;
  }

  .pricing:has(input[value="yearly"]:checked) .when-yearly {
    display: revert;
  }

  .pricing:has(input[value="yearly"]:checked) .when-monthly {
    display: none;
  }

  .pricing:has(input[value="yearly"]:checked) .billing-note {
    visibility: visible;
  }

  /* Plans billed yearly have a second link to the same checkout, billed yearly. */
  .cta-yearly {
    display: none;
  }

  .pricing:has(input[value="yearly"]:checked) .cta-yearly {
    display: inline-flex;
  }

  .pricing:has(input[value="yearly"]:checked) .cta-monthly {
    display: none;
  }

  /* Only animate a price that the visitor switched, not on page load. */
  .pricing:has(.billing:focus-within) :is(.amount-yearly, .amount.when-monthly) {
    animation: price-in 360ms var(--spring);
  }

  @keyframes price-in {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
  }

  /* Cards */
  .plans {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
  }

  @media (min-width: 40rem) {
    .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .plans {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
    box-shadow: var(--shadow-sm);
  }

  .plan.featured {
    border-color: var(--ink);
    box-shadow:
      0 0 0 0.0625rem var(--ink),
      var(--shadow);
  }

  .plan-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .plan-emoji {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
    font-size: 1.5rem;
  }

  .badge {
    padding: 0.3125rem 0.625rem;
    border-radius: var(--pill);
    background: var(--accent);
    color: var(--on-accent);
    font: 500 0.75rem / 1 var(--font-mono);
  }

  .plan-name {
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .blurb {
    min-height: 2.75rem;
    margin-top: 0.25rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    margin-top: 1.25rem;
  }

  .amount {
    font: 700 2.75rem / 1 var(--font-display);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .per {
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  .price-alt {
    min-height: 1.5rem;
    margin-top: 0.375rem;
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .plan-cta {
    width: 100%;
    margin: 1.25rem 0 1.5rem;
  }

  .includes {
    padding-top: 1.25rem;
    border-top: 0.0625rem solid var(--line);
    color: var(--ink);
    font-weight: 600;
    font-size: 0.875rem;
  }

  ul {
    display: grid;
    gap: 0.625rem;
    margin: 0.875rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  li {
    display: flex;
    gap: 0.625rem;
  }

  li strong {
    color: var(--ink);
    font-weight: 650;
  }

  .check {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.125rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fine {
    max-width: 46rem;
    margin-inline: auto;
    color: var(--ink-2);
    font-size: 0.9375rem;
    text-align: center;
  }

  .fine .emoji {
    margin-inline-end: 0.375rem;
  }

  .fine strong {
    color: var(--ink);
    font-weight: 600;
  }

  .fine a {
    color: var(--ink);
    text-underline-offset: 0.2em;
    text-decoration-color: var(--line-strong);
  }

  .fine a:hover {
    text-decoration-color: currentColor;
  }
</style>
