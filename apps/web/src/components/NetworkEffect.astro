---
import { i18nFor } from "../i18n/page";

const { t } = i18nFor(Astro);
const layers = [
  {
    emoji: "📱",
    title: t("network.layers.device.title"),
    body: t("network.layers.device.body"),
    speed: "< 1 ms",
    limited: false,
  },
  {
    emoji: "🗂️",
    title: t("network.layers.popular.title"),
    body: t("network.layers.popular.body"),
    speed: t("network.nearestCity"),
    limited: false,
  },
  {
    emoji: "⚡",
    title: t("network.layers.recent.title"),
    body: t("network.layers.recent.body"),
    speed: t("network.nearestCity"),
    limited: false,
  },
  {
    emoji: "🧠",
    title: t("network.layers.ai.title"),
    body: t("network.layers.ai.body"),
    speed: "≈ 50 ms",
    limited: true,
  },
];
---

<section id="network" class="section section-soft" aria-labelledby="network-title">
  <div class="container">
    <div class="section-head center">
      <p class="kicker">{t("network.kicker")}</p>
      <h2 id="network-title">{t("network.title")}</h2>
      <p class="lead">{t("network.lead")}</p>
    </div>

    <div class="net-grid">
      <div class="ladder card">
        <div class="ladder-top">
          <p class="ladder-title">{t("network.ladderTitle")}</p>
          <label class="switch">
            <input type="checkbox" role="switch" />
            <span class="track" aria-hidden="true"><span class="thumb"></span></span>
            <span>{t("network.limitSwitch")}</span>
          </label>
        </div>
        <ol>
          {
            layers.map((l) => (
              <li class:list={["rung", { limited: l.limited }]}>
                <span class="rung-emoji emoji" aria-hidden="true">
                  {l.emoji}
                </span>
                <div class="rung-text">
                  <h3>{l.title}</h3>
                  <p>{l.body}</p>
                </div>
                <div class="rung-meta">
                  <span class="speed" dir="ltr">{l.speed}</span>
                  <span class="state on">{t("network.answers")}</span>
                  <span class="state over">{l.limited ? t("network.untilNextMonth") : t("network.stillAnswers")}</span>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="ladder-note">{t("network.note")}</p>
      </div>

      <aside class="loop card" aria-labelledby="loop-title">
        <h3 id="loop-title">{t("network.loop.title")}</h3>
        <ol class="cycle">
          <li><span class="emoji" aria-hidden="true">⌨️</span> {t("network.loop.search")}</li>
          <li><span class="emoji" aria-hidden="true">🧠</span> {t("network.loop.learn")}</li>
          <li><span class="emoji" aria-hidden="true">🗂️</span> {t("network.loop.ready")}</li>
          <li><span class="emoji" aria-hidden="true">🚀</span> {t("network.loop.faster")}</li>
        </ol>
        <p class="quote">{t("network.loop.quote")}</p>
        <p class="privacy">
          <span class="emoji" aria-hidden="true">🔒</span> {t("network.loop.privacy")}
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .net-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 60rem) {
    .net-grid {
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    }
  }

  .ladder {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .ladder-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .ladder-title {
    font: 800 1.125rem / 1.2 var(--font-display);
  }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.875rem 0.375rem 0.375rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--pill);
    font-weight: 700;
    font-size: 0.875rem;
    cursor: pointer;
    user-select: none;
  }

  .switch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .track {
    position: relative;
    width: 2.5rem;
    height: 1.5rem;
    border-radius: var(--pill);
    background: var(--line);
    transition: background 160ms;
  }

  .thumb {
    position: absolute;
    top: 0.1875rem;
    inset-inline-start: 0.1875rem;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--shadow-sm);
    transition: transform 220ms var(--spring);
  }

  .switch:has(input:checked) .track {
    background: var(--bad);
  }

  .switch:has(input:checked) .thumb {
    transform: translateX(1rem);
  }

  .switch:has(input:checked) .thumb:dir(rtl) {
    transform: translateX(-1rem);
  }

  .switch:has(input:focus-visible) {
    outline: 0.1875rem solid #3d7bff;
    outline-offset: 0.1875rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rung {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 1rem 0;
    border-top: 0.0625rem solid var(--line);
    transition: opacity 200ms;
  }

  .rung-emoji {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.875rem;
    background: var(--bg-soft);
    font-size: 1.375rem;
  }

  .rung h3 {
    font-size: 1.125rem;
  }

  .rung p {
    margin-top: 0.25rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .rung-meta {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 40rem) {
    .rung {
      grid-template-columns: auto minmax(0, 1fr) 9.5rem;
    }

    .rung-meta {
      grid-column: 3;
      flex-direction: column;
      align-items: flex-end;
      margin-top: 0;
    }
  }

  .speed,
  .state {
    padding: 0.25rem 0.625rem;
    border-radius: var(--pill);
    font: 700 0.8125rem / 1.2 var(--font-body);
    white-space: nowrap;
  }

  .speed {
    background: var(--bg-soft);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .state.on {
    background: var(--mint);
    color: var(--good);
  }

  .state.over {
    display: none;
    background: var(--mint);
    color: var(--good);
  }

  .ladder:has(input:checked) .state.on {
    display: none;
  }

  .ladder:has(input:checked) .state.over {
    display: inline-block;
  }

  .ladder:has(input:checked) .limited .state.over {
    background: var(--peach);
    color: var(--bad);
  }

  .ladder:has(input:checked) .limited :is(.rung-emoji, .rung-text) {
    opacity: 0.45;
  }

  .ladder-note {
    padding-top: 1rem;
    border-top: 0.0625rem solid var(--line);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .loop {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .loop h3 {
    font-size: 1.125rem;
  }

  .cycle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 2.25rem;
  }

  .cycle li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.375rem;
    padding: 0.875rem 0.5rem;
    border-radius: var(--radius);
    background: var(--bg-soft);
    text-align: center;
    font-weight: 700;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .cycle .emoji {
    font-size: 1.5rem;
  }

  .cycle li::after {
    position: absolute;
    color: var(--ink-3);
    font-weight: 800;
    font-size: 1.125rem;
  }

  /* Clockwise: top-left → top-right → bottom-right → bottom-left → back up. */
  .cycle li:nth-child(1)::after {
    content: "→";
    inset-inline-end: -1.625rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .cycle li:nth-child(2)::after {
    content: "↓";
    bottom: -1.75rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .cycle li:nth-child(3) {
    order: 4;
  }

  .cycle li:nth-child(3)::after {
    content: "←";
    inset-inline-start: -1.625rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .cycle li:nth-child(4) {
    order: 3;
    background: var(--ink);
    color: var(--bg);
  }

  /* Right to left the grid mirrors, so the sideways arrows swap. */
  .cycle li:nth-child(1):dir(rtl)::after {
    content: "←";
  }

  .cycle li:nth-child(3):dir(rtl)::after {
    content: "→";
  }

  .cycle li:nth-child(4)::after {
    content: "↑";
    top: -1.75rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .quote {
    font: 700 1.25rem / 1.3 var(--font-display);
    letter-spacing: -0.01em;
  }

  .privacy {
    color: var(--ink-2);
    font-size: 0.875rem;
  }
</style>
