---
import { DASHBOARD_URL, REPO_URL } from "../config";
import LanguageSwitcher from "../i18n/LanguageSwitcher.astro";
import { DEFAULT_LOCALE, isLocalizedPath } from "../i18n/locales";
import { i18nFor } from "../i18n/page";

interface Props {
  /** English path of the current page. */
  path: string;
}

const { path } = Astro.props;
const { t, href, locale } = i18nFor(Astro);
const links = [
  { href: "/#use-cases", label: t("nav.product") },
  { href: "/#features", label: t("nav.features") },
  { href: "/#integrations", label: t("nav.integrations") },
  { href: "/playground/", label: t("nav.playground") },
  { href: "/pricing/", label: t("nav.pricing") },
  { href: "/docs/", label: t("nav.docs") },
].map((link) => ({
  ...link,
  url: href(link.href),
  current: path.startsWith(link.href) && link.href !== "/" ? ("page" as const) : undefined,
  // Translated pages mark the links that lead to English-only pages.
  english: locale !== DEFAULT_LOCALE && !isLocalizedPath(link.href),
}));
---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href={href("/")} aria-label={t("nav.home")}>
      <span class="logo-mark emoji" aria-hidden="true">🦖</span>
      <span class="logo-word">emojisense</span>
    </a>
    <nav class="nav-main" aria-label={t("nav.main")}>
      <ul class="links">
        {
          links.map((link) => (
            <li>
              <a href={link.url} aria-current={link.current} hreflang={link.english ? "en" : undefined}>
                {link.label}
                {link.english && <span class="visually-hidden"> {t("nav.inEnglish")}</span>}
              </a>
            </li>
          ))
        }
        <li class="nav-github"><a href={REPO_URL}>GitHub</a></li>
      </ul>
    </nav>
    <div class="actions">
      <div class="nav-lang"><LanguageSwitcher path={path} variant="menu" /></div>
      <a class="signin" href={`${DASHBOARD_URL}/`}>{t("nav.signIn")}</a>
      <a class="btn btn-primary cta" href={`${DASHBOARD_URL}/`}>{t("nav.getKey")}</a>
      <details class="menu">
        <summary aria-label={t("nav.menu")}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <div class="menu-panel">
          <nav aria-label={t("nav.mainMobile")}>
            {
              links.map((link) => (
                <a href={link.url} aria-current={link.current} hreflang={link.english ? "en" : undefined}>
                  {link.label}
                  {link.english && (
                    <span class="lang-hint">
                      <span aria-hidden="true">EN</span>
                      <span class="visually-hidden">{t("nav.inEnglish")}</span>
                    </span>
                  )}
                </a>
              ))
            }
            <a href={REPO_URL}>GitHub</a>
            <a href={`${DASHBOARD_URL}/`}>{t("nav.signIn")}</a>
          </nav>
          <div class="menu-lang">
            <LanguageSwitcher path={path} variant="list" />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu after a pick (in-page anchors do not reload) and on Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(".nav .menu")) {
    menu.querySelector(".menu-panel")?.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) menu.open = false;
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.6) blur(0.75rem);
    border-bottom: 0.0625rem solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .logo-mark {
    font-size: 1.5rem;
    transition: transform 240ms var(--spring);
  }

  .logo:hover .logo-mark {
    transform: rotate(-10deg) scale(1.08);
  }

  .logo-word {
    font: 700 1.25rem / 1 var(--font-display);
    letter-spacing: -0.035em;
  }

  .links {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a,
  .signin {
    padding: 0.5rem 0.75rem;
    border-radius: var(--pill);
    color: var(--ink-2);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .links a:hover,
  .signin:hover,
  .links a[aria-current="page"] {
    color: var(--ink);
    background: var(--bg-soft);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .cta {
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .signin {
    white-space: nowrap;
  }

  /* With Playground in the list, tighten the links before they collide with the actions. */
  @media (max-width: 66rem) {
    .nav-inner {
      gap: 1rem;
    }

    .links a {
      padding-inline: 0.5rem;
    }

    .nav-github {
      display: none;
    }
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0.0625rem solid var(--line-strong);
    border-radius: var(--pill);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .menu-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    inset-inline-end: 0;
    display: grid;
    min-width: 13rem;
    max-height: calc(100vh - 5rem);
    padding: 0.375rem;
    overflow-y: auto;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow-lg);
  }

  .menu-panel nav {
    display: grid;
  }

  .menu-lang {
    margin-top: 0.375rem;
    padding: 0.75rem 0.75rem 0.5rem;
    border-top: 0.0625rem solid var(--line);
    font-size: 0.9375rem;
  }

  .menu-lang :global(.lang-list a) {
    padding: 0;
  }

  .menu-lang :global(.lang-list a:hover) {
    background: none;
  }

  .menu-panel nav a {
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }

  .menu-panel nav a:hover,
  .menu-panel nav a[aria-current="page"] {
    background: var(--bg-soft);
    color: var(--ink);
  }

  @media (max-width: 56rem) {
    .nav-main {
      display: none;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 26rem) {
    .signin {
      display: none;
    }
  }

  /* On a phone the language list lives in the menu, so the bar keeps room for the key button. */
  @media (max-width: 34rem) {
    .nav-lang {
      display: none;
    }
  }

  /* At 320 px the logo, the key button and the menu were 0.5rem wider than the screen. */
  @media (max-width: 22.5rem) {
    .nav-inner {
      gap: 0.5rem;
    }

    .cta {
      padding-inline: 0.75rem;
    }
  }
</style>
