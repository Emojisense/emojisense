---
import { i18nFor } from "../i18n/page";
import { cityBubbles } from "../lib/showcase";
import { CITIES, landDots, MAP, MAP_HEIGHT, project } from "../lib/world";

const { t, messages } = i18nFor(Astro);
const dots = landDots();
const cities = new Map(CITIES.map(([name, lon, lat]) => [name, project(lon, lat)]));
const STILL = new Set(["Los Angeles", "São Paulo", "Istanbul", "Shanghai", "Sydney"]);

const bubbles = cityBubbles.flatMap((b, i) => {
  const at = cities.get(b.city);
  if (!at) return [];
  const left = (at.x / MAP.width) * 100;
  const align = left < 18 ? "start" : left > 82 ? "end" : "center";
  return [{ ...b, i, left, top: (at.y / MAP_HEIGHT) * 100, align, still: STILL.has(b.city) }];
});

/*
 * The title names one city at a time, the city of the bubble that pops on the map. Each language
 * writes the city with its own grammar ("in Paris", "Paris'te") and puts it on a line of its own
 * with "\n", so the title never rewraps. That whole line turns, punctuation included.
 */
const cityNames: Record<string, string> = messages.edge.cities;
const SLOT = "\u{E000}";
const titleLines = t("edge.titleCity", { city: SLOT })
  .split("\n")
  .map((line) =>
    line.includes(SLOT)
      ? { reel: bubbles.map((b) => line.replace(SLOT, cityNames[b.city] ?? b.city)) }
      : { text: line },
  );

const stats = [
  { value: "300+", label: t("edge.stats.cities") },
  { value: "< 1 ms", label: t("edge.stats.device") },
  { value: "≈ 50 ms", label: t("edge.stats.ai") },
  { value: "0", label: t("edge.stats.zero") },
];
---

<section id="edge" class="edge" aria-labelledby="edge-title">
  <div class="container">
    <div class="edge-head">
      <p class="kicker">{t("edge.kicker")}</p>
      <h2 id="edge-title">
        <span class="title-still" data-title-still>{t("edge.title")}</span>
        <span class="title-reel" data-title-reel aria-hidden="true" hidden>
          {
            titleLines.map((line) => (
              <span class="title-line">
                {line.reel ? (
                  <span class="reel" data-reel>
                    {line.reel.map((city) => (
                      <span class="reel-city">{city}</span>
                    ))}
                  </span>
                ) : (
                  line.text
                )}
              </span>
            ))
          }
        </span>
      </h2>
      <p class="lead">{t("edge.lead")}</p>
    </div>

    <figure class="map">
      {/* WCAG 2.2.2: the bubbles move on their own, so they get a pause. It works once the script runs. */}
      <button type="button" class="map-pause" data-map-pause data-label-pause={t("edge.pause")} data-label-play={t("edge.play")}>
        <svg class="map-pause-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path class="map-pause-bars" d="M4.5 3h2.25v10H4.5zM9.25 3h2.25v10H9.25z"></path>
          <path class="map-pause-play" d="M5 2.75v10.5L13 8z"></path>
        </svg>
        <span class="map-pause-label">{t("edge.pause")}</span>
      </button>
      <div class="map-canvas" dir="ltr" style={`--n: ${bubbles.length}; aspect-ratio: ${MAP.width} / ${MAP_HEIGHT}`}>
        <svg viewBox={`0 0 ${MAP.width} ${MAP_HEIGHT}`} aria-hidden="true" focusable="false">
          <path class="land" d={dots}></path>
          {[...cities.values()].map((c) => <circle class="city" cx={c.x} cy={c.y} r="3.2"></circle>)}
        </svg>
        {
          bubbles.map((b) => (
            <div
              class:list={["bubble", `align-${b.align}`, { still: b.still }]}
              style={`left: ${b.left.toFixed(2)}%; top: ${b.top.toFixed(2)}%; --i: ${b.i}`}
              lang={b.locale}
            >
              <span class="ping" aria-hidden="true" />
              <span class="card">
                <span class="emoji">{b.emoji}</span>
                <span class="query">{b.query}</span>
              </span>
            </div>
          ))
        }
      </div>
      <figcaption>{t("edge.caption")}</figcaption>
    </figure>

    <ul class="edge-stats">
      {
        stats.map((s) => (
          <li>
            <strong dir="ltr">{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  /** The bubble timing in the CSS below: one bubble pops every 2.4 s, the first 0.6 s early. */
  const SLOT_MS = 2400;
  const LEAD_MS = 600;

  interface Reel {
    play(): void;
    stop(): void;
  }

  /**
   * Turns the title to the city of each bubble as it pops. It reads the time from the first
   * bubble's CSS animation, so the title and the map stay together after a pause or a hidden tab.
   */
  function createReel(section: Element, map: Element): Reel | undefined {
    const still = section.querySelector("[data-title-still]");
    const live = section.querySelector<HTMLElement>("[data-title-reel]");
    const reel = section.querySelector<HTMLElement>("[data-reel]");
    const bubble = map.querySelector(".bubble");
    if (!still || !live || !reel || !bubble) return undefined;
    const line = reel.parentElement ?? reel;
    const cities = [...reel.children] as HTMLElement[];
    let shown = -1;
    let timer = 0;

    still.classList.add("visually-hidden");
    live.hidden = false;

    /** Paused, the bubbles have no animation and the clock reads 0: the first city. */
    const clock = () => Number(bubble.getAnimations()[0]?.currentTime ?? 0) + LEAD_MS;

    const show = (index: number) => {
      if (index === shown) return;
      cities.forEach((city, i) => {
        if (i === index) city.dataset.state = "in";
        else if (i === shown) city.dataset.state = "out";
        else delete city.dataset.state;
      });
      // In em of the reel, so the width follows the font size. A long name on a narrow phone shrinks.
      const em = Number.parseFloat(getComputedStyle(reel).fontSize);
      const width = (cities[index]?.getBoundingClientRect().width ?? 0) / em;
      const parentEm = Number.parseFloat(getComputedStyle(line).fontSize);
      reel.style.fontSize = `${Math.min(1, line.clientWidth / (width * parentEm))}em`;
      reel.style.width = `${width}em`;
      shown = index;
    };

    function tick() {
      window.clearTimeout(timer);
      const now = clock();
      show(Math.floor(now / SLOT_MS) % cities.length);
      timer = window.setTimeout(tick, SLOT_MS - (now % SLOT_MS) + 20);
    }

    show(Math.floor(clock() / SLOT_MS) % cities.length);
    return {
      play: tick,
      stop: () => window.clearTimeout(timer),
    };
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-map-pause]")) {
    const map = button.closest(".map");
    const section = button.closest("section");
    const label = button.querySelector(".map-pause-label");
    if (!map || !section || !label) continue;
    map.setAttribute("data-ready", "");

    // Under reduced motion the title keeps its still text, like the map keeps still bubbles.
    let reel: Reel | undefined;
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      void document.fonts.ready.then(() => {
        reel = createReel(section, map);
        if (!map.hasAttribute("data-paused")) reel?.play();
      });
    }

    // Paused, the map shows the same still bubbles as under reduced motion, and the title stops.
    button.addEventListener("click", () => {
      const paused = map.toggleAttribute("data-paused");
      label.textContent = (paused ? button.dataset.labelPlay : button.dataset.labelPause) ?? "";
      if (paused) reel?.stop();
      else reel?.play();
    });
  }
</script>

<style>
  .edge {
    --edge-bg: #0d0d12;
    --edge-ink: #f4f2fa;
    --edge-ink-2: #c4bfd3;
    --edge-ink-3: #8d889c;
    --edge-line: #24242c;
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem);
    background:
      radial-gradient(50rem 22rem at 50% 0%, rgb(255 255 255 / 0.06), transparent 70%),
      var(--edge-bg);
    color: var(--edge-ink);
    border-block: 0.0625rem solid var(--edge-line);
  }

  .edge-head {
    max-width: 46rem;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .edge .kicker {
    color: var(--edge-ink-3);
  }

  .edge h2 {
    font-size: clamp(2.25rem, 1.3rem + 3.4vw, 3.75rem);
  }

  .edge .lead {
    color: var(--edge-ink-2);
  }

  .title-line {
    display: block;
  }

  /* All cities share one grid cell; the script sets the width of the one on show. */
  .reel {
    display: inline-grid;
    padding-block: 0.2em;
    margin-block: -0.2em;
    clip-path: inset(0);
    transition:
      width 600ms var(--ease-out),
      font-size 600ms var(--ease-out);
  }

  .reel-city {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(100%);
  }

  .reel-city[data-state="in"] {
    opacity: 1;
    transform: none;
    transition:
      transform 600ms cubic-bezier(0.34, 1.4, 0.64, 1),
      opacity 300ms;
  }

  .reel-city[data-state="out"] {
    transform: translateY(-100%);
    transition:
      transform 450ms cubic-bezier(0.5, 0, 0.75, 0),
      opacity 250ms;
  }

  .map {
    position: relative;
    margin: 0 auto;
    max-width: 68rem;
  }

  .map-pause {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    min-height: 2rem;
    padding: 0.375rem 0.75rem 0.375rem 0.625rem;
    border: 0.0625rem solid #34343e;
    border-radius: var(--pill);
    background: rgb(13 13 18 / 0.8);
    color: var(--edge-ink-2);
    font: 500 0.75rem / 1 var(--font-mono);
    cursor: pointer;
    transition:
      color 160ms,
      border-color 160ms;
  }

  /* Its place is kept until it works, so nothing moves when it appears. */
  .map:not([data-ready]) .map-pause {
    visibility: hidden;
  }

  .map-pause:hover {
    border-color: #55555f;
    color: var(--edge-ink);
  }

  .map-pause-icon {
    width: 0.75rem;
    height: 0.75rem;
    fill: currentColor;
  }

  .map-pause-play,
  .map[data-paused] .map-pause-bars {
    display: none;
  }

  .map[data-paused] .map-pause-play {
    display: inline;
  }

  .map-canvas {
    position: relative;
  }

  .map-canvas > svg {
    width: 100%;
    height: 100%;
  }

  .land {
    fill: none;
    stroke: #2c2c36;
    stroke-width: 3.6;
    stroke-linecap: round;
  }

  .city {
    fill: #f3f3f6;
    opacity: 0.9;
  }

  .bubble {
    position: absolute;
    width: 0;
    height: 0;
    animation: bubble-cycle calc(var(--n) * 2.4s) linear infinite both;
    animation-delay: calc(var(--i) * 2.4s - 0.6s);
    opacity: 0;
  }

  .ping {
    position: absolute;
    left: -0.625rem;
    top: -0.625rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    border: 0.125rem solid #f3f3f6;
    animation: ping 1.2s ease-out infinite;
  }

  .card {
    position: absolute;
    bottom: 0.75rem;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem 0.375rem 0.4375rem;
    border-radius: var(--pill);
    background: #fff;
    color: #15121f;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.45);
    white-space: nowrap;
    font: 700 clamp(0.75rem, 0.65rem + 0.4vw, 0.9375rem) / 1 var(--font-body);
    transform: translateX(-50%);
  }

  .card::after {
    content: "";
    position: absolute;
    bottom: -0.3125rem;
    left: 50%;
    width: 0.625rem;
    height: 0.625rem;
    background: #fff;
    transform: translateX(-50%) rotate(45deg);
  }

  .align-start .card {
    transform: translateX(-1.25rem);
  }

  .align-start .card::after {
    left: 1.25rem;
  }

  .align-end .card {
    transform: translateX(calc(-100% + 1.25rem));
  }

  .align-end .card::after {
    left: calc(100% - 1.25rem);
  }

  .card .emoji {
    display: grid;
    place-items: center;
    width: 1.75em;
    height: 1.75em;
    border-radius: 50%;
    background: #f1eff7;
    font-size: 1.125em;
  }

  figcaption {
    margin-top: 1rem;
    color: var(--edge-ink-3);
    text-align: center;
    font-size: 0.8125rem;
  }

  .edge-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1px;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    overflow: hidden;
    border: 0.0625rem solid var(--edge-line);
    border-radius: var(--radius-lg);
    background: var(--edge-line);
    list-style: none;
  }

  .edge-stats li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--edge-bg);
  }

  .edge-stats strong {
    color: var(--edge-ink);
    font: 700 clamp(2rem, 1.5rem + 1.6vw, 2.75rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .edge-stats span {
    color: var(--edge-ink-2);
    font-size: 0.9375rem;
  }

  @keyframes bubble-cycle {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    3% {
      opacity: 1;
      transform: scale(1);
    }
    17% {
      opacity: 1;
      transform: scale(1);
    }
    20%,
    100% {
      opacity: 0;
      transform: scale(0.9);
    }
  }

  @keyframes ping {
    from {
      opacity: 1;
      transform: scale(0.4);
    }
    to {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  @media (max-width: 40rem) {
    /* The map is short on a phone: the control goes under it, not over the bubbles. */
    .map {
      display: flex;
      flex-direction: column;
    }

    .map-pause {
      position: static;
      order: 1;
      align-self: center;
      margin-top: 0.75rem;
    }

    figcaption {
      order: 2;
    }

    .card .query {
      display: none;
    }

    .card {
      padding: 0.25rem;
    }
  }

  /* Paused, or under reduced motion: five bubbles stand still and nothing pings. */
  .map[data-paused] .bubble {
    animation: none;
    opacity: 0;
  }

  .map[data-paused] .bubble.still {
    opacity: 1;
  }

  .map[data-paused] .ping {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
      opacity: 0;
    }

    .bubble.still {
      opacity: 1;
    }

    .ping,
    .map-pause {
      display: none;
    }
  }
</style>
