---
import { cityBubbles } from "../lib/showcase";
import { CITIES, landDots, MAP, MAP_HEIGHT, project } from "../lib/world";

const dots = landDots();
const cities = new Map(CITIES.map(([name, lon, lat]) => [name, project(lon, lat)]));
const STILL = new Set(["Los Angeles", "São Paulo", "Istanbul", "Shanghai", "Sydney"]);

const bubbles = cityBubbles.flatMap((b, i) => {
  const at = cities.get(b.city);
  if (!at) return [];
  const left = (at.x / MAP.width) * 100;
  const align = left < 18 ? "start" : left > 82 ? "end" : "center";
  return [{ ...b, i, left, top: (at.y / MAP_HEIGHT) * 100, align, still: STILL.has(b.city) }];
});

const stats = [
  { value: "300+", label: "cities on Cloudflare's network. 95% of internet users are within 50 ms of one." },
  { value: "< 1 ms", label: "for answers on the device, at every keystroke. Measured p95: 0.4 ms." },
  { value: "≈ 50 ms", label: "for an AI meaning search inside the edge. Measured p50: 52 ms." },
  { value: "0", label: "servers, regions or GPUs for you to run, scale or pay for." },
];
---

<section id="edge" class="edge" aria-labelledby="edge-title">
  <div class="container">
    <div class="edge-head">
      <p class="eyebrow"><span class="emoji" aria-hidden="true">🌐</span> Global edge</p>
      <h2 id="edge-title">Fast in Lagos, Lima and Lahore.</h2>
      <p class="lead">
        Emojisense runs on Cloudflare's network in 300+ cities. Every search is answered in the city closest to
        your user — never in one faraway region.
      </p>
    </div>

    <figure class="map">
      <div class="map-canvas" style={`--n: ${bubbles.length}; aspect-ratio: ${MAP.width} / ${MAP_HEIGHT}`}>
        <svg viewBox={`0 0 ${MAP.width} ${MAP_HEIGHT}`} aria-hidden="true" focusable="false">
          <path class="land" d={dots}></path>
          {[...cities.values()].map((c) => <circle class="city" cx={c.x} cy={c.y} r="3.2"></circle>)}
        </svg>
        {
          bubbles.map((b) => (
            <div
              class:list={["bubble", `align-${b.align}`, { still: b.still }]}
              style={`left: ${b.left.toFixed(2)}%; top: ${b.top.toFixed(2)}%; --i: ${b.i}`}
              lang={b.locale}
            >
              <span class="ping" aria-hidden="true" />
              <span class="card">
                <span class="emoji">{b.emoji}</span>
                <span class="query">{b.query}</span>
              </span>
            </div>
          ))
        }
      </div>
      <figcaption>
        Real searches and the emoji our engine returns for them. The map is an illustration; dots show large
        cities, not exact data centers.
      </figcaption>
    </figure>

    <ul class="edge-stats">
      {
        stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .edge {
    --edge-bg: #15121f;
    --edge-ink: #f4f2fa;
    --edge-ink-2: #c4bfd3;
    --edge-ink-3: #8d889c;
    --edge-line: #2e2a3b;
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem);
    background:
      radial-gradient(50rem 22rem at 50% 0%, rgb(255 210 63 / 0.1), transparent 70%),
      var(--edge-bg);
    color: var(--edge-ink);
    border-block: 0.0625rem solid var(--edge-line);
  }

  .edge-head {
    max-width: 46rem;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .edge .eyebrow {
    background: rgb(255 210 63 / 0.14);
    color: var(--brand);
  }

  .edge h2 {
    font-size: clamp(2.25rem, 1.3rem + 3.4vw, 3.75rem);
  }

  .edge .lead {
    color: var(--edge-ink-2);
  }

  .map {
    margin: 0 auto;
    max-width: 68rem;
  }

  .map-canvas {
    position: relative;
  }

  .map svg {
    width: 100%;
    height: 100%;
  }

  .land {
    fill: none;
    stroke: #3a3549;
    stroke-width: 3.6;
    stroke-linecap: round;
  }

  .city {
    fill: var(--brand);
    opacity: 0.85;
  }

  .bubble {
    position: absolute;
    width: 0;
    height: 0;
    animation: bubble-cycle calc(var(--n) * 2.4s) linear infinite both;
    animation-delay: calc(var(--i) * 2.4s - 0.6s);
    opacity: 0;
  }

  .ping {
    position: absolute;
    left: -0.625rem;
    top: -0.625rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    border: 0.125rem solid var(--brand);
    animation: ping 1.2s ease-out infinite;
  }

  .card {
    position: absolute;
    bottom: 0.75rem;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem 0.375rem 0.4375rem;
    border-radius: var(--pill);
    background: #fff;
    color: #15121f;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.45);
    white-space: nowrap;
    font: 700 clamp(0.75rem, 0.65rem + 0.4vw, 0.9375rem) / 1 var(--font-body);
    transform: translateX(-50%);
  }

  .card::after {
    content: "";
    position: absolute;
    bottom: -0.3125rem;
    left: 50%;
    width: 0.625rem;
    height: 0.625rem;
    background: #fff;
    transform: translateX(-50%) rotate(45deg);
  }

  .align-start .card {
    transform: translateX(-1.25rem);
  }

  .align-start .card::after {
    left: 1.25rem;
  }

  .align-end .card {
    transform: translateX(calc(-100% + 1.25rem));
  }

  .align-end .card::after {
    left: calc(100% - 1.25rem);
  }

  .card .emoji {
    display: grid;
    place-items: center;
    width: 1.75em;
    height: 1.75em;
    border-radius: 50%;
    background: var(--brand);
    font-size: 1.125em;
  }

  figcaption {
    margin-top: 1rem;
    color: var(--edge-ink-3);
    text-align: center;
    font-size: 0.8125rem;
  }

  .edge-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1px;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    overflow: hidden;
    border: 0.0625rem solid var(--edge-line);
    border-radius: var(--radius-lg);
    background: var(--edge-line);
    list-style: none;
  }

  .edge-stats li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--edge-bg);
  }

  .edge-stats strong {
    color: var(--brand);
    font: 800 clamp(2rem, 1.5rem + 1.6vw, 2.75rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .edge-stats span {
    color: var(--edge-ink-2);
    font-size: 0.9375rem;
  }

  @keyframes bubble-cycle {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    3% {
      opacity: 1;
      transform: scale(1);
    }
    17% {
      opacity: 1;
      transform: scale(1);
    }
    20%,
    100% {
      opacity: 0;
      transform: scale(0.9);
    }
  }

  @keyframes ping {
    from {
      opacity: 1;
      transform: scale(0.4);
    }
    to {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  @media (max-width: 40rem) {
    .card .query {
      display: none;
    }

    .card {
      padding: 0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
      opacity: 0;
    }

    .bubble.still {
      opacity: 1;
    }

    .ping {
      display: none;
    }
  }
</style>
