---
/**
 * The landing page's integrations: one engine in the middle, the brands people build with around it.
 * Each brand opens its card on /integrations/; install steps live there and in the docs.
 */
import { i18nFor } from "../i18n/page";
import { cardPath, GROUPS, HUB, INTEGRATIONS, integrationOf } from "../lib/integrations";
import { LOGO_VIEWBOX, LOGOS } from "../lib/logos";
import { stats } from "../lib/showcase";

const { t, plural, href, tag } = i18nFor(Astro);
const number = new Intl.NumberFormat(tag);
const facts = [
  { count: INTEGRATIONS.length, unit: "integrations.units.integrations" },
  { count: stats.languages, unit: "integrations.units.languages" },
  { count: 1, unit: "integrations.units.engines" },
] as const;
---

<section id="integrations" class="section hub-section" aria-labelledby="integrations-title">
  <div class="container">
    <div class="section-head center">
      <p class="kicker"><span class="emoji" aria-hidden="true">🔌</span> {t("integrations.kicker")}</p>
      <h2 id="integrations-title">{t("integrations.title")}</h2>
      <p class="lead">{t("integrations.lead")}</p>
    </div>

    <div class="hub" data-play-in-view>
      <svg class="hub-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M50 50 L41 25" />
        <path d="M50 50 L59 25" />
        <path d="M50 50 L41 75" />
        <path d="M50 50 L59 75" />
      </svg>

      <div class="hub-core" aria-hidden="true">
        <span class="hub-core-mark emoji">🦖</span>
        <span class="hub-core-word">emojisense</span>
        <span class="hub-core-note">{t("integrations.hub.core")}</span>
      </div>

      {
        GROUPS.map((group) => (
          <div class:list={["hub-group", `hub-${group}`]}>
            <h3 class="hub-group-title" id={`hub-${group}`}>
              {t(`integrations.groups.${group}`)}
            </h3>
            <ul class="hub-tiles" aria-labelledby={`hub-${group}`}>
              {HUB[group].map((brand) => {
                const logo = brand.logo ? LOGOS[brand.logo] : undefined;
                const label = logo ? logo.label : t(`integrations.items.${brand.key}.name`);
                return (
                  <li>
                    <a class="hub-tile" href={href(cardPath(integrationOf(brand.key)))}>
                      {logo?.kind === "icon" && (
                        <svg class="hub-icon" viewBox={logo.viewBox ?? LOGO_VIEWBOX} aria-hidden="true" focusable="false">
                          <path d={logo.path} />
                        </svg>
                      )}
                      {brand.mark && (
                        <span class="hub-mark" aria-hidden="true">
                          {brand.mark}
                        </span>
                      )}
                      <span class:list={["hub-label", { "hub-wordmark": logo?.kind === "wordmark" }]}>{label}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    <ul class="hub-facts">
      {
        facts.map((fact) => (
          <li>
            <strong>{number.format(fact.count)}</strong> {plural(fact.unit, fact.count)}
          </li>
        ))
      }
    </ul>

    <p class="hub-cta">
      <a class="btn btn-primary btn-lg" href={href("/integrations/")}>
        {t("integrations.hub.cta")}
        <svg class="hub-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M3.5 8h9M8.5 4l4 4-4 4" />
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  .hub {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1rem;
  }

  .hub-lines {
    display: none;
  }

  .hub-core {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    justify-self: center;
    padding: 1.25rem 1.75rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--bg);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .hub-core-mark {
    font-size: 2.75rem;
  }

  .hub-core-word {
    font: 700 1.375rem / 1.1 var(--font-display);
    letter-spacing: -0.035em;
  }

  .hub-core-note {
    color: var(--ink-3);
    font: 500 0.75rem / 1.3 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .hub-group {
    padding: 1.25rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .hub-group-title {
    margin: 0 0 0.875rem;
    color: var(--ink-3);
    font: 500 0.8125rem / 1.2 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .hub-tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hub-tile {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 0.0625rem solid var(--line);
    border-radius: var(--pill);
    background: var(--bg);
    color: var(--ink-2);
    font: 600 0.9375rem / 1 var(--font-body);
    text-decoration: none;
    transition:
      border-color 160ms,
      color 160ms,
      box-shadow 200ms var(--ease-out),
      translate 240ms var(--spring);
  }

  .hub-tile:hover {
    border-color: var(--line-strong);
    color: var(--ink);
    box-shadow: var(--shadow);
    translate: 0 -0.125rem;
  }

  .hub-icon {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
  }

  /* Brands without an open-licensed mark: the name, set as a wordmark. */
  .hub-wordmark {
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .hub-mark {
    padding: 0.1875rem 0.375rem;
    border: 0.0625rem solid currentColor;
    border-radius: 0.375rem;
    font: 500 0.6875rem / 1 var(--font-mono);
  }

  .hub-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding: 0;
    color: var(--ink-2);
    list-style: none;
  }

  .hub-facts strong {
    color: var(--ink);
    font: 700 1.5rem / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .hub-cta {
    display: flex;
    justify-content: center;
    margin-top: 1.75rem;
  }

  .hub-arrow {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 240ms var(--spring);
  }

  .hub-cta a:hover .hub-arrow {
    translate: 0.1875rem 0;
  }

  .hub-arrow:dir(rtl) {
    scale: -1 1;
  }

  .hub-cta a:hover .hub-arrow:dir(rtl) {
    translate: -0.1875rem 0;
  }

  @media (min-width: 40rem) {
    .hub {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hub-core {
      grid-column: 1 / -1;
    }
  }

  /* Wide screens: the engine in the middle, a group in each corner, lines from the engine. */
  @media (min-width: 60rem) {
    .hub {
      grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.5fr) minmax(0, 1fr);
      grid-template-areas:
        "editors core frameworks"
        "native core servers";
      column-gap: 0;
      row-gap: 4.5rem;
    }

    .hub-lines {
      position: absolute;
      inset: 0;
      z-index: -1;
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .hub-lines path {
      fill: none;
      stroke: var(--line-strong);
      stroke-width: 1.5;
      stroke-dasharray: 4 6;
      vector-effect: non-scaling-stroke;
    }

    .hub-core {
      grid-area: core;
      grid-column: auto;
      align-self: center;
    }

    .hub-group {
      align-self: center;
      border-color: transparent;
      background: transparent;
    }

    .hub-editors {
      grid-area: editors;
    }

    .hub-frameworks {
      grid-area: frameworks;
    }

    .hub-native {
      grid-area: native;
    }

    .hub-servers {
      grid-area: servers;
    }

    /* The groups on the start side lean toward the engine. */
    .hub-editors,
    .hub-native {
      text-align: end;
    }

    .hub-editors .hub-tiles,
    .hub-native .hub-tiles {
      justify-content: flex-end;
    }

    /* Once on screen, the lines flow into the engine for a moment (index.astro sets data-playing). */
    .hub[data-playing] .hub-lines path {
      animation: hub-flow 2.4s var(--ease-out);
    }

    .hub[data-playing] .hub-core {
      animation: hub-beat 900ms var(--ease-out) 1.6s;
    }
  }

  @keyframes hub-flow {
    from {
      stroke-dashoffset: -60;
    }
  }

  @keyframes hub-beat {
    40% {
      scale: 1.04;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-tile:hover {
      translate: none;
    }
  }
</style>
