---
import { DASHBOARD_URL, REPO_URL } from "../config";

interface Props {
  path: string;
}

const { path } = Astro.props;
const links = [
  { href: "/docs/", label: "Docs" },
  { href: "/pricing/", label: "Pricing" },
];
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-current={path === "/" ? "page" : undefined}>
      <span class="sticker logo" aria-hidden="true">🦖</span>
      emojisense
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="hide-narrow"><a href={REPO_URL}>GitHub</a></li>
        <li><a class="button button-primary cta" href={`${DASHBOARD_URL}/`}>Get a key</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--paper);
    border-bottom: 0.125rem solid var(--ink);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-height);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font: 700 var(--step-1) / 1 var(--font-display);
    text-decoration: none;
  }

  .logo {
    --tilt: -8deg;
    font-size: 1.5rem;
    animation: none;
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a:not(.button) {
    color: var(--ink);
    font: 600 var(--step--1) / 1 var(--font-body);
    text-decoration: none;
  }

  nav a:not(.button):hover,
  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 0.1875rem;
    text-decoration-color: var(--sun);
    text-underline-offset: 0.4em;
  }

  .cta {
    min-height: 2.5rem;
    margin-bottom: 0.25rem;
    padding: 0.375rem 0.875rem;
    font-size: var(--step--1);
  }

  @media (max-width: 30rem) {
    .hide-narrow {
      display: none;
    }

    ul {
      gap: 0.75rem;
    }

    .wordmark {
      font-size: var(--step-0);
    }

    .logo {
      font-size: 1.25rem;
    }
  }
</style>
