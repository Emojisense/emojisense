---
import { REPO_URL } from "../config";

const columns = [
  {
    title: "Product",
    links: [
      { href: "/", label: "Home" },
      { href: "/pricing/", label: "Pricing" },
      { href: "/waitlist/", label: "Pro waitlist" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: "/docs/", label: "Quickstart" },
      { href: "/docs/api/", label: "HTTP API" },
      { href: "/docs/pack-format/", label: "Pack format" },
      { href: "/docs/self-host/", label: "Self-host" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: REPO_URL, label: "Source on GitHub" },
      { href: "/docs/privacy/", label: "Privacy" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <p class="wordmark">emojisense</p>
      <p>
        Code is MIT. Emoji data comes from Emojibase (MIT) and Unicode CLDR (Unicode License v3). Emoji
        draw with your system font.
      </p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="heading">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 6rem);
    padding-block: 2.5rem 3rem;
    background: var(--cloud);
    border-top: 0.125rem solid var(--ink);
    font-size: var(--step--1);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .wordmark {
    margin: 0 0 0.5rem;
    font: 700 var(--step-1) / 1 var(--font-display);
  }

  .about p:last-child {
    max-width: 36ch;
    margin: 0;
    color: var(--muted);
  }

  .heading {
    margin: 0 0 0.5rem;
    font-weight: 800;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.375rem;
  }

  a {
    color: var(--ink);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about {
      grid-column: 1 / -1;
    }
  }
</style>
