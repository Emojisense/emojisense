---
/** A quiet "Works with" row for under the hero. Place it inside a `.container`. */
import { i18nFor } from "../i18n/page";
import { LOGO_VIEWBOX, LOGOS, type LogoName } from "../lib/logos";

const { t } = i18nFor(Astro);

const names: LogoName[] = [
  "react",
  "vue",
  "svelte",
  "angular",
  "tiptap",
  "lexical",
  "swift",
  "chrome",
  "raycast",
  "wordpress",
  "discourse",
  "mcp",
];
---

<div class="strip">
  <p class="strip-label">{t("home.logos.worksWith")}</p>
  <ul class="strip-list">
    {
      names.map((name) => {
        const logo = LOGOS[name];
        return (
          <li class="strip-item" title={logo.title}>
            {logo.kind === "icon" && (
              <svg viewBox={LOGO_VIEWBOX} aria-hidden="true" focusable="false">
                <path d={logo.path} />
              </svg>
            )}
            <span>{logo.label}</span>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.75rem;
  }

  .strip-label {
    flex: none;
    color: var(--ink-3);
    font: 500 0.8125rem / 1 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .strip-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .strip-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    color: var(--ink-2);
    font: 650 0.9375rem / 1 var(--font-display);
    letter-spacing: -0.02em;
    transition: color 200ms;
  }

  .strip-item:hover {
    color: var(--ink);
  }

  .strip-item svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
  }

  @media (max-width: 40rem) {
    .strip-label {
      flex-basis: 100%;
    }

    .strip-list {
      gap: 0.75rem 1.25rem;
    }
  }
</style>
