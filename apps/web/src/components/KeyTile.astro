---
import { codePointLabel } from "../lib/format";

interface Props {
  emoji: string;
  id: string;
}

const { emoji, id } = Astro.props;
---

<span class="keycap tile">
  <span class="glyph">{emoji}</span>
  <span class="hex" aria-hidden="true">{codePointLabel(id).slice(2)}</span>
</span>

<style>
  .tile {
    display: inline-grid;
    justify-items: center;
    align-content: center;
    gap: 0.25rem;
    width: 3.75rem;
    aspect-ratio: 1;
    margin-bottom: 0.25rem;
    vertical-align: middle;
  }

  .glyph {
    font: 1.625rem / 1 var(--font-emoji);
  }

  .hex {
    font: 400 0.625rem / 1 var(--font-mono);
    opacity: 0.7;
  }
</style>
