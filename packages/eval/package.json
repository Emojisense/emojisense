    "eval:paths": "tsx src/paths.ts",
    "culture:gate": "tsx src/culture-gate-cli.ts",
    "heldout:generate": "tsx scripts/make-heldout.ts",
    "photos": "tsx src/photos.ts",
    "reactions": "tsx src/reactions.ts",
    "romanized": "tsx src/romanized.ts",
    "rerank:train": "tsx src/rerank-train.ts",
    "sentences": "tsx src/sentences.ts",
    "cost": "tsx src/cost-cli.ts",
