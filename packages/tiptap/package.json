{
  "name": "@emojisense/tiptap",
  "version": "0.0.0",
  "description": "Tiptap extension: `:` emoji autocomplete ranked by Emojisense.",
  "keywords": [
    "emoji",
    "emoji-search",
    "tiptap",
    "tiptap-extension",
    "prosemirror",
    "autocomplete",
    "editor"
  ],
  "homepage": "https://emojisense.com",
  "bugs": {
    "url": "https://github.com/emojisense/emojisense/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emojisense/emojisense.git",
    "directory": "packages/tiptap"
  },
  "license": "MIT",
  "author": "Emojisense <support@emojisense.com> (https://emojisense.com)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "emojisense": "workspace:^"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/suggestion": "^3.28.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.8.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "happy-dom": "20.14.5"
  }
}
