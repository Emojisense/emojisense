{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emojisense-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  // Invocation logs would record full request URLs (search text, keys, invite tokens); only our
  // own structured logs, which never contain them, are kept.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // docs/API.md: the Search API runs on 8788 locally (8787 is taken on the owner's machine).
  "dev": { "port": 8788 },
  "assets": {
    "directory": "./public",
    // src/locale-engines.ts reads pack.<locale>.json of locales outside the bundle through it.
    // `assets` is inherited by the offline env, binding included.
    "binding": "ASSETS",
    // Packs (/v1/pack/*) are static assets: free, and they never run the Worker. Only the API
    // routes run it first; the negative rule keeps packs on the asset path. Cache headers:
    // public/_headers (sync-pack.ts). Shards (/p/*) and culture files (/v1/culture/*) run the
    // Worker: it serves the published build from R2 (SHARDS: nightly shards, culture entries
    // approved in the dashboard), else the deployed static files (DECISIONS.md, "Culture Phase 2").
    "run_worker_first": ["/v1/*", "!/v1/pack/*", "/p/*"]
  },
  // Workers AI has no local emulator: even `wrangler dev` calls Cloudflare (needs `wrangler login`).
  // Without it the Worker degrades to alias-only results.
  "ai": { "binding": "AI" },
  // Shared with apps/dashboard: keys, apps, usage and custom emoji (packages/platform/migrations).
  // `wrangler dev` uses a local SQLite file named after `database_id`. It must equal the
  // dashboard's id, so both Workers read the same local database under ../../.wrangler/state.
  // Before a deploy, replace the placeholder with the id from `wrangler d1 create emojisense`.
  // Apply migrations with `pnpm db:migrate` (once for both Workers).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emojisense",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../platform/migrations"
    }
  ],
  // Custom emoji images, written by the dashboard and the tenants API, served at
  // /v1/custom/:appId/:emojiId. Local R2 state is keyed by bucket_name, so both Workers share it
  // under --persist-to (CONTRACT.md "Storage").
  // SHARDS: layer-2 shard builds of the nightly job (src/shards/), served at /p/*. API Worker only.
  "r2_buckets": [
    { "binding": "EMOJI", "bucket_name": "emojisense-emoji" },
    { "binding": "SHARDS", "bucket_name": "emojisense-shards" }
  ],
  // Per minute (src/auth.ts). SITE_LIMITER is the per-IP budget of publishable-key calls from
  // FIRST_PARTY_ORIGINS (the website's public key). KEY_MISS_LIMITER counts, per IP, key lookups
  // that miss the isolate's key cache (each one a D1 read), so random keys cannot flood D1.
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "ANON_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "SITE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "KEY_MISS_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "emojisense_search" }],
  // Daily, 03:17 UTC: write the regional trends (src/trends.ts), then delete query_daily rows past
  // their plan's retention, waitlist rows older than 12 months and trends older than 90 days
  // (src/retention.ts). Daily, 04:23 UTC: build the layer-2 shards from
  // query_daily (src/shards/job.ts, SHARD_BUILD_CRON in src/config.ts; SHARDS_CRON_ENABLED).
  // Daily, 04:41 UTC: culture proposals (Workers AI drafts for editors) and a publish of the
  // approved live entries; every 10 minutes: publish again after a deploy or an approval
  // (src/culture-admin/, CULTURE_*_CRON; CULTURE_CRON_ENABLED, CULTURE_PROPOSE_BUDGET).
  // Inherited by the offline env. Locally: `wrangler dev --test-scheduled`, then
  // curl "http://localhost:8788/__scheduled?cron=17+3+*+*+*" (or cron=23+4+*+*+*, 41+4+*+*+*).
  "triggers": { "crons": ["17 3 * * *", "23 4 * * *", "41 4 * * *", "*/10 * * * *"] },
  // Text modules: the culture prompt and the in-house eval suite (src/culture-admin/bundle.ts).
  "rules": [
    { "type": "Data", "globs": ["**/*.bin"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.md", "**/*.jsonl"], "fallthrough": true }
  ],
  "vars": {
    // Keys accepted without a database row (`key` or `key:plan`, comma-separated), metered in
    // memory only. pk_demo is the demo app's key; remove it once the demo has a real key.
    "DEV_KEYS": "pk_demo",
    // "true" runs the nightly shard build; set it to "false" to stop it (the served build stays).
    "SHARDS_CRON_ENABLED": "true",
    // Our own pages (src/auth.ts, src/sets/access.ts): the website (astro dev) and the dashboard
    // (vite, wrangler dev).
    "FIRST_PARTY_ORIGINS": "http://localhost:4321,http://localhost:5173,http://localhost:8790",
    // "true" runs the nightly culture proposals (drafts only; editors approve in the dashboard).
    // CULTURE_PROPOSE_BUDGET caps the Workers AI calls per night (≈ $0.0005 each).
    "CULTURE_CRON_ENABLED": "true",
    "CULTURE_PROPOSE_BUDGET": "12"
  },
  "env": {
    // `wrangler dev --env offline`: no Workers AI binding, so it runs with no Cloudflare login.
    // Bindings do not inherit into environments, so they are repeated here.
    "offline": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../platform/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "EMOJI", "bucket_name": "emojisense-emoji" },
        { "binding": "SHARDS", "bucket_name": "emojisense-shards" }
      ],
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
        { "name": "ANON_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
        { "name": "SITE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
        { "name": "KEY_MISS_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "emojisense_search" }],
      // ENVIRONMENT=development lets webhooks reach http://localhost receivers.
      // No Workers AI here, so the shard build logs "shards_skipped" (no Workers AI).
      // LOCAL_EMBED_URL: search and reactions embed with scripts/local_embed_server.py (the
      // production model, same vectors); without the server they answer alias-only, degraded.
      "vars": {
        "DEV_KEYS": "pk_demo,sk_live_local:pro",
        "ENVIRONMENT": "development",
        "LOCAL_EMBED_URL": "http://127.0.0.1:8765",
        "SHARDS_CRON_ENABLED": "true",
        "FIRST_PARTY_ORIGINS": "http://localhost:4321,http://localhost:5173,http://localhost:8790",
        "CULTURE_CRON_ENABLED": "true",
        "CULTURE_PROPOSE_BUDGET": "12"
      }
    },
    // Internal dev environment at api.emojisense.dev (`pnpm deploy:dev`). Not "development":
    // that value unlocks localhost-only behaviour. Own D1 and R2, never shared with production.
    "dev": {
      // Traces and invocation logs record the full request URL (search text, publishable key) and
      // the user agent, so they are on for the internal dev environment only. Invocation logs add
      // cpuTimeMs and wallTimeMs per request: the CPU work Server-Timing cannot show (Workers
      // clocks stop during computation). Production keeps logs without URLs.
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true },
        "traces": { "enabled": true, "head_sampling_rate": 1 }
      },
      "routes": [{ "pattern": "api.emojisense.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense-dev",
          "database_id": "6e481b34-37e5-472b-9a74-0e7bfddae494",
          "migrations_dir": "../platform/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "EMOJI", "bucket_name": "emojisense-emoji-dev" },
        { "binding": "SHARDS", "bucket_name": "emojisense-shards-dev" }
      ],
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
        { "name": "ANON_LIMITER", "namespace_id": "1102", "simple": { "limit": 30, "period": 60 } },
        { "name": "SITE_LIMITER", "namespace_id": "1103", "simple": { "limit": 60, "period": 60 } },
        { "name": "KEY_MISS_LIMITER", "namespace_id": "1104", "simple": { "limit": 60, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "emojisense_search_dev" }],
      "vars": {
        "DEV_KEYS": "pk_demo",
        "ENVIRONMENT": "staging",
        "SHARDS_CRON_ENABLED": "true",
        "FIRST_PARTY_ORIGINS": "https://emojisense.dev,https://app.emojisense.dev",
        "CULTURE_CRON_ENABLED": "true",
        "CULTURE_PROPOSE_BUDGET": "12"
      }
    },
    // Production at api.emojisense.com (`pnpm deploy:production`). No dev keys: every key is a
    // database row with its own origins and plan.
    "production": {
      "routes": [{ "pattern": "api.emojisense.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense-prod",
          "database_id": "6bb3345c-a77d-449a-bec3-f81a59a81439",
          "migrations_dir": "../platform/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "EMOJI", "bucket_name": "emojisense-emoji-prod" },
        { "binding": "SHARDS", "bucket_name": "emojisense-shards-prod" }
      ],
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "1201", "simple": { "limit": 120, "period": 60 } },
        { "name": "ANON_LIMITER", "namespace_id": "1202", "simple": { "limit": 30, "period": 60 } },
        { "name": "SITE_LIMITER", "namespace_id": "1203", "simple": { "limit": 60, "period": 60 } },
        { "name": "KEY_MISS_LIMITER", "namespace_id": "1204", "simple": { "limit": 60, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "emojisense_search" }],
      "vars": {
        "DEV_KEYS": "",
        "ENVIRONMENT": "production",
        "SHARDS_CRON_ENABLED": "true",
        "FIRST_PARTY_ORIGINS": "https://emojisense.com,https://www.emojisense.com,https://app.emojisense.com",
        "CULTURE_CRON_ENABLED": "true",
        "CULTURE_PROPOSE_BUDGET": "12"
      }
    }
  }
}
