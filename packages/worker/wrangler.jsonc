{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emojisense-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  // Invocation logs would record full request URLs (search text, keys, invite tokens); only our
  // own structured logs, which never contain them, are kept.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // docs/API.md: the Search API runs on 8788 locally (8787 is taken on the owner's machine).
  "dev": { "port": 8788 },
  "assets": {
    "directory": "./public",
    // src/locale-engines.ts reads pack.<locale>.json of locales outside the bundle through it.
    // `assets` is inherited by the offline env, binding included.
    "binding": "ASSETS",
    // Packs (/v1/pack/*), culture files (/v1/culture/*) and shards (/p/*) are static assets: free,
    // and they never run the Worker. Only the API routes run it first; the negative rules keep
    // packs and culture files on the asset path. Cache headers: public/_headers (sync-pack.ts).
    "run_worker_first": ["/v1/*", "!/v1/pack/*", "!/v1/culture/*"]
  },
  // Workers AI has no local emulator: even `wrangler dev` calls Cloudflare (needs `wrangler login`).
  // Without it the Worker degrades to alias-only results.
  "ai": { "binding": "AI" },
  // Shared with apps/dashboard: keys, apps, usage and custom emoji (packages/platform/migrations).
  // `wrangler dev` uses a local SQLite file named after `database_id`. It must equal the
  // dashboard's id, so both Workers read the same local database under ../../.wrangler/state.
  // Before a deploy, replace the placeholder with the id from `wrangler d1 create emojisense`.
  // Apply migrations with `pnpm db:migrate` (once for both Workers).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emojisense",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../platform/migrations"
    }
  ],
  // Custom emoji images, written by the dashboard and the tenants API, served at
  // /v1/custom/:appId/:emojiId. Local R2 state is keyed by bucket_name, so both Workers share it
  // under --persist-to (CONTRACT.md "Storage").
  "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji" }],
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "ANON_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "emojisense_search" }],
  // Daily, 03:17 UTC: delete query_daily rows past their plan's retention and waitlist rows
  // older than 12 months (src/retention.ts).
  // Inherited by the offline env. Locally: `wrangler dev --test-scheduled`, then
  // curl "http://localhost:8788/__scheduled?cron=17+3+*+*+*".
  "triggers": { "crons": ["17 3 * * *"] },
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }],
  "vars": {
    // Keys accepted without a database row (`key` or `key:plan`, comma-separated), metered in
    // memory only. pk_demo is the demo app's key; remove it once the demo has a real key.
    "DEV_KEYS": "pk_demo"
  },
  "env": {
    // `wrangler dev --env offline`: no Workers AI binding, so it runs with no Cloudflare login.
    // Bindings do not inherit into environments, so they are repeated here.
    "offline": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../platform/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji" }],
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
        { "name": "ANON_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "emojisense_search" }],
      // ENVIRONMENT=development lets webhooks reach http://localhost receivers.
      "vars": { "DEV_KEYS": "pk_demo,sk_live_local:pro", "ENVIRONMENT": "development" }
    },
    // Internal dev environment at api.emojisense.dev (`pnpm deploy:dev`). Not "development":
    // that value unlocks localhost-only behaviour. Own D1 and R2, never shared with production.
    "dev": {
      "routes": [{ "pattern": "api.emojisense.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense-dev",
          "database_id": "6e481b34-37e5-472b-9a74-0e7bfddae494",
          "migrations_dir": "../platform/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji-dev" }],
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
        { "name": "ANON_LIMITER", "namespace_id": "1102", "simple": { "limit": 30, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "emojisense_search_dev" }],
      "vars": { "DEV_KEYS": "pk_demo", "ENVIRONMENT": "staging" }
    },
    // Production at api.emojisense.com (`pnpm deploy:production`). No dev keys: every key is a
    // database row with its own origins and plan.
    "production": {
      "routes": [{ "pattern": "api.emojisense.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "emojisense-prod",
          "database_id": "6bb3345c-a77d-449a-bec3-f81a59a81439",
          "migrations_dir": "../platform/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "EMOJI", "bucket_name": "emojisense-emoji-prod" }],
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "1201", "simple": { "limit": 120, "period": 60 } },
        { "name": "ANON_LIMITER", "namespace_id": "1202", "simple": { "limit": 30, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "emojisense_search" }],
      "vars": { "DEV_KEYS": "", "ENVIRONMENT": "production" }
    }
  }
}
