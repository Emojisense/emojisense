{
  "name": "@emojisense/lexical",
  "version": "0.0.0",
  "description": "Lexical React plugin: `:` emoji autocomplete ranked by Emojisense.",
  "keywords": [
    "emoji",
    "emoji-search",
    "lexical",
    "lexical-plugin",
    "autocomplete",
    "typeahead",
    "react",
    "editor"
  ],
  "homepage": "https://emojisense.com",
  "bugs": {
    "url": "https://github.com/emojisense/emojisense/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emojisense/emojisense.git",
    "directory": "packages/lexical"
  },
  "license": "MIT",
  "author": "Emojisense <support@emojisense.com> (https://emojisense.com)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "emojisense": "workspace:^"
  },
  "peerDependencies": {
    "@lexical/react": ">=0.30.0",
    "lexical": ">=0.30.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@lexical/list": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/rich-text": "0.51.0",
    "@lexical/table": "0.51.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "lexical": "0.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
