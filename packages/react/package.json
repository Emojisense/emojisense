{
  "name": "@emojisense/react",
  "version": "0.0.0",
  "description": "React hooks for Emojisense and an adapter for the Frimousse emoji picker.",
  "keywords": [
    "emoji",
    "emoji-picker",
    "emoji-search",
    "react",
    "react-hooks",
    "frimousse",
    "shadcn"
  ],
  "homepage": "https://emojisense.com",
  "bugs": {
    "url": "https://github.com/emojisense/emojisense/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emojisense/emojisense.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Emojisense",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./frimousse": {
      "types": "./dist/frimousse.d.ts",
      "default": "./dist/frimousse.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/r"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build-registry.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p registry/tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run"
  },
  "dependencies": {
    "emojisense": "workspace:^"
  },
  "peerDependencies": {
    "frimousse": ">=0.4.0",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "frimousse": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "frimousse": "0.4.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
