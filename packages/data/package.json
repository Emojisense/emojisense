{
  "name": "@emojisense/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "merge": "tsx src/merge.ts",
    "validate": "tsx src/validate.ts",
    "build:pack": "tsx src/build-pack.ts",
    "embed": "tsx src/embed.ts",
    "embed:glyph": "tsx src/embed-glyph.ts",
    "build:shards": "tsx src/build-shards.ts",
    "build:shards:base": "tsx src/build-base-shards.ts",
    "upload:shards": "tsx src/upload-shards.ts",
    "build": "tsx src/ingest.ts && tsx src/validate.ts && tsx src/build-pack.ts",
    "check:enrichment": "tsx scripts/check-enrichment.ts",
    "culture:check": "tsx src/culture/check.ts",
    "culture:propose": "tsx src/culture/propose.ts",
    "culture:review": "tsx src/culture/review.ts",
    "culture:build": "tsx src/culture/build.ts",
    "culture:import-live": "tsx src/culture/import-live.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "cldr-annotations-derived-full": "48.2.0",
    "cldr-annotations-full": "48.2.0",
    "emojibase-data": "17.0.0",
    "emojisense": "workspace:*"
  },
  "exports": {
    "./config": "./src/config.ts",
    "./culture": "./src/culture/index.ts",
    "./culture-core": "./src/culture/core.ts",
    "./culture/*": "./culture/*",
    "./embeddings": "./src/embeddings.ts",
    "./semantic-score": "./src/semantic-score.ts",
    "./locales": "./src/locales.ts",
    "./models": "./src/models.ts",
    "./paths": "./src/paths.ts",
    "./shards": "./src/shards/index.ts",
    "./vector-files": "./src/vector-files.ts"
  },
  "devDependencies": {
    "wrangler": "4.139.0",
    "@cloudflare/workers-types": "5.20260924.1"
  }
}
