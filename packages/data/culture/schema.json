{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emojisense.dev/schemas/culture-entry.json",
  "title": "Emojisense culture entry",
  "description": "One editorial association, packages/data/culture/entries/<id>.json. The schema covers the shape; src/culture/validate.ts adds the rules a schema cannot express (catalog hexcodes, normalized triggers, window lengths, exclusions, context per targeted locale).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "kind",
    "context",
    "when",
    "regions",
    "locales",
    "triggers",
    "emoji",
    "source",
    "createdBy",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "approved", "retired"] },
    "kind": {
      "description": "regional: a word whose main sense differs by region; the only kind that may take rank 1 (see outranks).",
      "enum": ["lasting", "seasonal", "event", "regional"]
    },
    "context": {
      "description": "Neutral reason per locale. English is always present; every targeted locale too.",
      "type": "object",
      "required": ["en"],
      "propertyNames": { "enum": ["en", "zh", "hi", "es", "ar", "fr", "bn", "pt", "ru", "id", "tr"] },
      "additionalProperties": { "type": "string", "minLength": 3, "maxLength": 90 }
    },
    "when": {
      "description": "lasting and regional: null. seasonal: a yearly MM-DD window (may wrap the year end) or one dated window. event: one dated window, at most 60 days.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "recurs"],
          "properties": {
            "from": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" },
            "to": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" },
            "recurs": { "const": "yearly" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "to": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      ]
    },
    "regions": {
      "description": "ISO 3166-1 alpha-2 codes, or [\"*\"]. Without a region from the app, only \"*\" entries apply.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(\\*|[A-Z]{2})$" }
    },
    "exceptRegions": {
      "description": "With regions [\"*\"]: ISO 3166-1 alpha-2 codes where the entry does not apply when the app names one.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "locales": {
      "description": "Pack locales whose culture file carries the entry, or [\"*\"].",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["*", "en", "zh", "hi", "es", "ar", "fr", "bn", "pt", "ru", "id", "tr"] }
    },
    "triggers": {
      "description": "Normalized phrases per targeted locale (docs/PACK_FORMAT.md §3).",
      "type": "object",
      "propertyNames": { "enum": ["en", "zh", "hi", "es", "ar", "fr", "bn", "pt", "ru", "id", "tr"] },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 48 }
      }
    },
    "emoji": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hexcode", "weight"],
        "properties": {
          "hexcode": { "type": "string", "pattern": "^[0-9A-F]{2,6}(-[0-9A-F]{2,6})*$" },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "outranks": {
      "description": "Regional entries only (required there): hexcodes of the canonical top answers the regional sense may move to second place.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9A-F]{2,6}(-[0-9A-F]{2,6})*$" }
    },
    "featured": {
      "type": "boolean",
      "description": "May appear on a \"relevant now\" shelf. Seasonal and event entries only."
    },
    "source": { "enum": ["editorial", "ai-proposed", "calendar"] },
    "createdBy": { "type": "string", "minLength": 1 },
    "reviewedBy": { "type": "string", "minLength": 1, "description": "Required when status is approved." },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$" }
  }
}
