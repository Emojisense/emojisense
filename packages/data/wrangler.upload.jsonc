// Only used by src/upload-shards.ts (getPlatformProxy) to write a CDN bucket from Node. Not
// deployed. One environment per bucket: a remote binding to a bucket that does not exist fails.
{
  "name": "emojisense-shard-upload",
  "compatibility_date": "2026-09-24",
  "env": {
    "dev": { "r2_buckets": [{ "binding": "CDN", "bucket_name": "emojisense-cdn-dev", "remote": true }] },
    "production": {
      "r2_buckets": [{ "binding": "CDN", "bucket_name": "emojisense-cdn-prod", "remote": true }]
    }
  }
}
