{
  "name": "emojisense-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:migrate": "pnpm --filter @emojisense/dashboard db:migrate",
    "data:build": "pnpm --filter @emojisense/data run build",
    "eval": "pnpm --filter @emojisense/eval run eval",
    "eval:ci": "pnpm --filter @emojisense/eval run eval:ci",
    "eval:inhouse": "pnpm --filter @emojisense/eval run eval:inhouse",
    "deploy:dev": "bash scripts/deploy.sh dev",
    "deploy:production": "bash scripts/deploy.sh production",
    "smoke:dev": "node scripts/smoke.mjs dev",
    "smoke:production": "node scripts/smoke.mjs production",
    "changeset": "changeset",
    "check:readmes": "node scripts/check-readmes.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:version": "changeset version",
    "release:publish": "node scripts/release-check.mjs --build --strict && changeset publish",
    "package:chrome": "pnpm --filter @emojisense/chrome-extension package",
    "package:raycast": "pnpm --filter emojisense-search store-export"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "turbo": "2.11.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "overrides": {
      "@clerk/shared": "4.35.0",
      "@types/react": "19.3.0"
    }
  }
}
