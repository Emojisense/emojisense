{
  "name": "emojisense-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "data:build": "pnpm --filter @emojisense/data run build",
    "eval": "pnpm --filter @emojisense/eval run eval",
    "eval:ci": "pnpm --filter @emojisense/eval run eval:ci"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "turbo": "2.11.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
