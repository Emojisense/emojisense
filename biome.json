{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.claude",
      "!packages/data/enrichment/i18n",
      "!packages/data/enrichment/_batches",
      "!packages/worker/src/generated",
      "!**/enrichment/*.json",
      "!**/reports/*.json",
      "!**/queries/*.jsonl",
      "!**/culture/entries/*.json",
      "!**/culture/sources/*.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
